[?2004h> from pathlib import Path
[?2004l[?2004h> p=[]
[?2004l[?2004h> for line in Path('graphene.dat').read_text().splitlines():
[?2004l[?2004h>  try:
[?2004l[?2004h>   a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))
[?2004l[?2004h>  except ValueError: pass
[?2004l[?2004h> p.sort()
[?2004l[?2004h> print('point-count by interval:')
[?2004l[?2004h> for lo,hi in [(1600,2000),(2000,2500),(2500,3000),(3000,4000),(4000,6000),(6000,9000),(9000,12000),(12000,15000),(15000,18000),(18000,20000),(20000,48000)]:
[?2004l[?2004h>  q=[(x,y) for x,y in p if lo<=x<hi]
[?2004l[?2004h>  print(f'{lo:6d}-{hi:6d}: {len(q):4d}')
[?2004l[?2004h> # Local linear sideband baseline and peak score in sliding windows.
[?2004l[?2004h> print('\nstrongest local-excess candidates across complete range:')
[?2004l[?2004h> c=[]
[?2004l[?2004h> for i in range(len(p)):
[?2004l[?2004h>  x,y=p[i]
[?2004l[?2004h>  # nearest 25 points each side, require separation
[?2004l[?2004h>  l=p[max(0,i-80):max(0,i-15)]; r=p[min(len(p),i+15):min(len(p),i+80)]
[?2004l[?2004h>  if len(l)<5 or len(r)<5: continue
[?2004l[?2004h>  # linear interpolation between side medians at x
[?2004l[?2004h>  import statistics
[?2004l[?2004h>  yl=statistics.median(v for _,v in l[-12:]); yr=statistics.median(v for _,v in r[:12])
[?2004l[?2004h>  xl=sum(v for v,_ in l[-12:])/12; xr=sum(v for v,_ in r[:12])/12
[?2004l[?2004h>  base=yl+(yr-yl)*(x-xl)/(xr-xl)
[?2004l[?2004h>  c.append((y-base,x,y,base))
[?2004l[?2004h> for d,x,y,b in sorted(c,key=lambda z:z[0],reverse=True)[:40]:
[?2004l[?2004h>  print(f'excess={d:10.2f} x={x:11.4f} y={y:10.2f} localbase={b:10.2f}')
[?2004l[?2004h> PY
