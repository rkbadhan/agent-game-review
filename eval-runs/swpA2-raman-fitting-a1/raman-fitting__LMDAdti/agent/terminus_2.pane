[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> p=[]
[?2004l[?2004h> for line in Path('graphene.dat').read_text().splitlines():
[?2004l[?2004h>     try: p.append(tuple(map(float,line.replace(',','.').split()[:2])))
[?2004l[?2004h>     except: pass
[?2004l[?2004h> # Sort by x for smoothing/rank diagnostics.
[?2004l[?2004h> p=sorted(p)
[?2004l[?2004h> x=[a for a,b in p]; y=[b for a,b in p]
[?2004l[?2004h> # Moving-average extrema using several window sizes.
[?2004l[?2004h> for w in (5,11,21):
[?2004l[?2004h>     z=[]
[?2004l[?2004h>     for i in range(len(y)):
[?2004l[?2004h>         lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); z.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h>     inds=sorted(sorted(range(len(z)),key=z.__getitem__,reverse=True)[:30])
[?2004l[?2004h>     print('\nwindow',w,'top smoothed candidates:')
[?2004l[?2004h>     out=[]
[?2004l[?2004h>     for i in inds:
[?2004l[?2004h>         # Keep one candidate per 20-point neighborhood.
[?2004l[?2004h>         if all(abs(x[i]-x[j])>20 for j in out): out.append(i)
[?2004l[?2004h>     for i in out[:15]: print(f'x={x[i]:10.3f} raw={y[i]:10.2f} smooth={z[i]:10.2f}')
[?2004l[?2004h> PY
