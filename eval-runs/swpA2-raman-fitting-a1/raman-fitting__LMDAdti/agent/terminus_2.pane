[?2004hroot@1eb0bf4552f6:/app# python3 - <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> p=sorted((lambda z:[(float(a.replace(',','.')),float(b.replace(',','.'))) for a,b in z])(line.split() for line in Path('graphene.dat').read_text().splitlines() if len(line.split())==2))
[?2004l[?2004h> x=[a for a,b in p]; y=[b for a,b in p]
[?2004l[?2004h> # Savitzky-Golay-like centered quadratic smoothing over about 35 cm^-1.
[?2004l[?2004h> w=15
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>     lo=max(0,i-w//2); hi=min(len(y),i+w//2+1)
[?2004l[?2004h>     sm.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h> cands=[]
[?2004l[?2004h> for i in range(2,len(y)-2):
[?2004l[?2004h>     if 1250<=x[i]<=3450 and sm[i]>=sm[i-1] and sm[i]>=sm[i+1]:
[?2004l[?2004h>         if all(abs(x[i]-x[j])>15 for j in cands): cands.append(i)
[?2004l[?2004h> print('local smoothed maxima:')
[?2004l[?2004h> for i in sorted(cands,key=lambda k:sm[k],reverse=True):
[?2004l[?2004h>     left=[y[j] for j in range(max(0,i-100),i) if abs(x[j]-x[i])<100]
[?2004l[?2004h>     right=[y[j] for j in range(i+1,min(len(y),i+101)) if abs(x[j]-x[i])<100]
[?2004l[?2004h>     print(f'i={i:4d} x={x[i]:9.3f} raw={y[i]:9.2f} smooth={sm[i]:9.2f} left100avg={sum(left)/len(left):9.2f} right100avg={sum(right)/len(right):9.2f}')
[?2004l[?2004h> PY
