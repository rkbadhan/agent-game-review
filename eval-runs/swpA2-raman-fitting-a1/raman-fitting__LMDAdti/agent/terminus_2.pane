[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> p=sorted((lambda rr:[(float(a.replace(',','.')),float(b.replace(',','.'))) for a,b in rr])(line.split()[:2] for line in Path('graphene.dat').read_text().splitlines() if len(line.split())>=2))
[?2004l[?2004h> x=[a for a,b in p]; y=[b for a,b in p]
[?2004l[?2004h> w=9
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>  lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h> c=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>  if 1200<=x[i]<=3500 and sm[i]==max(sm[max(0,i-15):min(len(y),i+16)]):
[?2004l[?2004h>   c.append(i)
[?2004l[?2004h> # Isolate within 30 cm^-1 and show strongest 25.
[?2004l[?2004h> out=[]
[?2004l[?2004h> for i in sorted(c,key=lambda k:sm[k],reverse=True):
[?2004l[?2004h>  if all(abs(x[i]-x[j])>30 for j in out): out.append(i)
[?2004l[?2004h> print('strongest isolated smoothed maxima:')
[?2004l[?2004h> for i in out[:25]: print(f'x={x[i]:9.3f} raw={y[i]:9.2f} smooth={sm[i]:9.2f}')
[?2004l[?2004h> for center,half in [(1585,80),(2700,150)]:
[?2004l[?2004h>  print('\nraw around',center)
[?2004l[?2004h>  for xx,yy in p:
[?2004l[?2004h>   if abs(xx-center)<=half and abs((xx*2)%10)<0.01: pass
[?2004l[?2004h>  q=[(xx,yy) for xx,yy in p if abs(xx-center)<=half]
[?2004l[?2004h>  # Print every fifth point plus extrema.
[?2004l[?2004h>  for xx,yy in q[::5]: print(f'{xx:9.3f} {yy:9.2f}')
[?2004l[?2004h>  xm,ym=max(q,key=lambda z:z[1]); xn,yn=min(q,key=lambda z:z[1]); print('MAX',xm,ym,'MIN',xn,yn)
