[?2004h> from pathlib import Path
[?2004l[?2004h> p=[]
[?2004l[?2004h> for line in Path('graphene.dat').read_text().splitlines():
[?2004l[?2004h>  try:
[?2004l[?2004h>   a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))
[?2004l[?2004h>  except ValueError: pass
[?2004l[?2004h> p.sort(); x=[a for a,b in p]; y=[b for a,b in p]
[?2004l[?2004h> w=9
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>  lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h> c=[]
[?2004l[?2004h> for i in range(len(x)):
[?2004l[?2004h>  if 5200<=x[i]<=6280:
[?2004l[?2004h>   neigh=[j for j in range(max(0,i-12),min(len(x),i+13))]
[?2004l[?2004h>   if sm[i]==max(sm[j] for j in neigh): c.append(i)
[?2004l[?2004h> out=[]
[?2004l[?2004h> for i in sorted(c,key=lambda k:sm[k],reverse=True):
[?2004l[?2004h>  if all(abs(x[i]-x[j])>20 for j in out): out.append(i)
[?2004l[?2004h> print('isolated smoothed maxima below 6280:')
[?2004l[?2004h> for i in out[:30]:
[?2004l[?2004h>  # robust side medians 80--250 A away
[?2004l[?2004h>  l=sorted(y[j] for j in range(len(x)) if 80<=x[i]-x[j]<=250)
