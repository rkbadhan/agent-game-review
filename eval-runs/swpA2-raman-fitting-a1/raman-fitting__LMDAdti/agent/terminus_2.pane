[?2004h> from pathlib import Path
[?2004l[?2004h> p=[]
[?2004l[?2004h> for line in Path('graphene.dat').read_text().splitlines():
[?2004l[?2004h>  try:
[?2004l[?2004h>   a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))
[?2004l[?2004h>  except ValueError: pass
[?2004l[?2004h> p.sort(); x=[a for a,b in p]; y=[b for a,b in p]
[?2004l[?2004h> w=11
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>  lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h> for name,lo,hi in [('G',5200,5800),('2D',5800,6310)]:
[?2004l[?2004h>  inds=[i for i in range(len(x)) if lo<=x[i]<=hi]
[?2004l[?2004h>  im=max(inds,key=lambda i:sm[i])
[?2004l[?2004h>  print('\n'+name,'smoothed max:',x[im],y[im],sm[im])
[?2004l[?2004h>  # half-height crossings on smoothed curve after local side baseline
[?2004l[?2004h>  side=[j for j in inds if x[j]<lo+50 or x[j]>hi-50]
[?2004l[?2004h>  base=sum(y[j] for j in side)/len(side)
[?2004l[?2004h>  target=(sm[im]+base)/2
[?2004l[?2004h>  li=im
[?2004l[?2004h>  while li>inds[0] and sm[li]>target: li-=1
[?2004l[?2004h>  ri=im
[?2004l[?2004h>  while ri<inds[-1] and sm[ri]>target: ri+=1
[?2004l[?2004h>  print('side baseline',base,'FWHM estimate',x[ri]-x[li],'crossings',x[li],x[ri])
[?2004l[?2004h>  print('points within +/- 150 of max:')
[?2004l[?2004h>  for j in inds:
[?2004l[?2004h>   if abs(x[j]-x[im])<=150: print(f'{x[j]:12.6f} {y[j]:12.6f} smooth={sm[j]:11.6f}')
[?2004l[?2004h> PY
