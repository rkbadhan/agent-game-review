[?2004l[?2004h> p.sort(); x=[a for a,b in p]; y=[b for a,b in p]
[?2004l[?2004h> w=11
[?2004l[?2004h> sm=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>  lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h> for name,pred in [('G',7033),('2D',7634)]:
[?2004l[?2004h>  inds=[i for i in range(len(x)) if pred-250<=x[i]<=pred+250]
[?2004l[?2004h>  im=max(inds,key=lambda i:sm[i])
[?2004l[?2004h>  # side medians 100--300 A away
[?2004l[?2004h>  def med(vals):
[?2004l[?2004h>   v=sorted(vals); return v[len(v)//2]
[?2004l[?2004h>  lm=med([y[j] for j in inds if 100<=x[im]-x[j]<=300]); rm=med([y[j] for j in inds if 100<=x[j]-x[im]<=300])
[?2004l[?2004h>  print('\n',name,'predicted',pred,'smoothed max',x[im],y[im],sm[im],'side medians',lm,rm)
[?2004l[?2004h>  target=(sm[im]+min(lm,rm))/2
[?2004l[?2004h>  li=im
[?2004l[?2004h>  while li>inds[0] and sm[li]>target:li-=1
[?2004l[?2004h>  ri=im
[?2004l[?2004h>  while ri<inds[-1] and sm[ri]>target:ri+=1
[?2004l[?2004h>  print('FWHM estimate',x[ri]-x[li], 'crossings',x[li],x[ri])
[?2004l[?2004h>  for j in inds:
[?2004l[?2004h>   if abs(x[j]-x[im])<=150: print(f'{x[j]:11.4f} {y[j]:10.2f} smooth={sm[j]:10.2f}')
