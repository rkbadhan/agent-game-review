[?2004hroot@1eb0bf4552f6:/app# python3 - <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> p=[]
[?2004l[?2004h> for line in Path('graphene.dat').read_text().splitlines():
[?2004l[?2004h>  try:
[?2004l[?2004h>   a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))
[?2004l[?2004h>  except ValueError: pass
[?2004l[?2004h> p.sort()
[?2004l[?2004h> for lo,hi,title in [(1540,1900,'G candidate'),(2450,2850,'nominal 2D candidate')]:
[?2004l[?2004h>  q=[(x,y) for x,y in p if lo<=x<=hi]
[?2004l[?2004h>  print('\n---',title,'every point sorted ascending ---')
[?2004l[?2004h>  for x,y in q: print(f'{x:12.6f} {y:12.6f}')
[?2004l[?2004h> PY
[?2004l
