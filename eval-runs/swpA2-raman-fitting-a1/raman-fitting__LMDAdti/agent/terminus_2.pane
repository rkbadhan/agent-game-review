[?2004hroot@1eb0bf4552f6:/app# python3 - <<'PY'
[?2004l[?2004h> from pathlib import Path
[?2004l[?2004h> p=[]
[?2004l[?2004h> for line in Path('graphene.dat').read_text().splitlines():
[?2004l[?2004h>  try:
[?2004l[?2004h>   a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))
[?2004l[?2004h>  except ValueError: pass
[?2004l[?2004h> p=sorted(p); x=[a for a,b in p]; y=[b for a,b in p]
[?2004l[?2004h> # Quadratic local smoothing over roughly 31 points.
[?2004l[?2004h> w=31; sm=[]
[?2004l[?2004h> for i in range(len(y)):
[?2004l[?2004h>  lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))
[?2004l[?2004h> # Local maxima and approximate prominence over nearest significant minima.
[?2004l[?2004h> c=[]
[?2004l[?2004h> for i in range(1,len(y)-1):
[?2004l[?2004h>  if sm[i]>=sm[i-1] and sm[i]>=sm[i+1]: c.append(i)
[?2004l[?2004h> out=[]
[?2004l[?2004h> for i in sorted(c,key=lambda k:sm[k],reverse=True):
[?2004l[?2004h>  if all(abs(x[i]-x[j])>50 for j in out): out.append(i)
[?2004l[?2004h> print('isolated smoothed maxima (strongest first):')
[?2004l[?2004h> for i in out[:40]:
[?2004l[?2004h>  l=sm[:i]; r=sm[i+1:]
[?2004l[?2004h>  # prominence relative to higher of the minimum-to-left/right saddle approximations
