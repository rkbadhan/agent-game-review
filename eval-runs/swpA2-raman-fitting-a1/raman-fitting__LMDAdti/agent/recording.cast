[629.965128, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort(); x=[a for a,b in p]; y=[b for a,b in p]\nw=11\nsm=[]\nfor i in range(len(y)):\n lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))\nfor name,lo,hi in [('G',5200,5800),('2D',5800,6310)]:\n inds=[i for i in range(len(x)) if lo<=x[i]<=hi]\n im=max(inds,key=lambda i:sm[i])\n print('\\n'+name,'smoothed max:',x[im],y[im],sm[im])\n # half-height crossings on smoothed curve after local side baseline\n side=[j for j in inds if x[j]<lo+50 or x[j]>hi-50]\n base=sum(y[j] for j in side)/len(side)\n target=(sm[im]+base)/2\n li=im\n while li>inds[0] and sm[li]>target: li-=1\n ri=im\n while ri<inds[-1] and sm[ri]>target: ri+=1\n print('side baseline',base,'FWHM estimate',x[ri]-x[li],'crossings',x[li],x[ri])\n print('points within +/- 150 of max:')\n for j in inds:\n  if abs(x[j]-x[im])<=150: print(f'{x[j]:12"]
[629.965326, "i", ".6f} {y[j]:12.6f} smooth={sm[j]:11.6f}')\nPY\n"]
