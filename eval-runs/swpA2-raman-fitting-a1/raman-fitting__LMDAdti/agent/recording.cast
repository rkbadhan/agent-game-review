[791.368952, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort()\nfor lo in range(6500,8200,25):\n q=[y for x,y in p if lo<=x<lo+25]\n if q:\n  m=sum(q)/len(q); sd=(sum((v-m)**2 for v in q)/len(q))**.5\n  xm,ym=max(((x,y) for x,y in p if lo<=x<lo+25),key=lambda z:z[1])\n  print(f'{lo:4d}-{lo+24:4d} n={len(q):2d} mean={m:9.1f} sd={sd:8.1f} max={ym:9.1f}@{xm:8.1f}')\nPY\n"]
