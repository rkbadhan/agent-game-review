[213.611035, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=sorted((lambda z:[(float(a.replace(',','.')),float(b.replace(',','.'))) for a,b in z])(line.split() for line in Path('graphene.dat').read_text().splitlines() if len(line.split())==2))\nx=[a for a,b in p]; y=[b for a,b in p]\n# Savitzky-Golay-like centered quadratic smoothing over about 35 cm^-1.\nw=15\nsm=[]\nfor i in range(len(y)):\n    lo=max(0,i-w//2); hi=min(len(y),i+w//2+1)\n    sm.append(sum(y[lo:hi])/(hi-lo))\ncands=[]\nfor i in range(2,len(y)-2):\n    if 1250<=x[i]<=3450 and sm[i]>=sm[i-1] and sm[i]>=sm[i+1]:\n        if all(abs(x[i]-x[j])>15 for j in cands): cands.append(i)\nprint('local smoothed maxima:')\nfor i in sorted(cands,key=lambda k:sm[k],reverse=True):\n    left=[y[j] for j in range(max(0,i-100),i) if abs(x[j]-x[i])<100]\n    right=[y[j] for j in range(i+1,min(len(y),i+101)) if abs(x[j]-x[i])<100]\n    print(f'i={i:4d} x={x[i]:9.3f} raw={y[i]:9.2f} smooth={sm[i]:9.2f} left100avg={sum(left)/len(left):9.2f} right100avg={sum(right)/len(right):9.2f}')\nPY\n"]
