[491.884359, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort()\nprint('point-count by interval:')\nfor lo,hi in [(1600,2000),(2000,2500),(2500,3000),(3000,4000),(4000,6000),(6000,9000),(9000,12000),(12000,15000),(15000,18000),(18000,20000),(20000,48000)]:\n q=[(x,y) for x,y in p if lo<=x<hi]\n print(f'{lo:6d}-{hi:6d}: {len(q):4d}')\n# Local linear sideband baseline and peak score in sliding windows.\nprint('\\nstrongest local-excess candidates across complete range:')\nc=[]\nfor i in range(len(p)):\n x,y=p[i]\n # nearest 25 points each side, require separation\n l=p[max(0,i-80):max(0,i-15)]; r=p[min(len(p),i+15):min(len(p),i+80)]\n if len(l)<5 or len(r)<5: continue\n # linear interpolation between side medians at x\n import statistics\n yl=statistics.median(v for _,v in l[-12:]); yr=statistics.median(v for _,v in r[:12])\n xl=sum(v for v,_ in l[-12:])/12; xr=sum(v for v,_ in"]
[491.884577, "i", " r[:12])/12\n base=yl+(yr-yl)*(x-xl)/(xr-xl)\n c.append((y-base,x,y,base))\nfor d,x,y,b in sorted(c,key=lambda z:z[0],reverse=True)[:40]:\n print(f'excess={d:10.2f} x={x:11.4f} y={y:10.2f} localbase={b:10.2f}')\nPY\n"]
[491.884763, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r r[:12])/12\r\n base=yl+(yr-yl)*(x-xl)/(xr-xl)\r\n c.append((y-base,x,y,base))\r\nfor d,x,y,b in sorted(c,key=lambda z:z[0],reverse=True)[:40]:\r\n print(f'excess={d:10.2f} x={x:11.4f} y={y:10.2f} localbase={b:10.2f}')\r\nPY\r\n\u001b[?2004h"]
