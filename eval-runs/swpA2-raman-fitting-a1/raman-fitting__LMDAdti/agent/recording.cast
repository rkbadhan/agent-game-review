[170.487641, "i", "python3 - <<'PY'\nfrom pathlib import Path\nrows=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n    try:\n        x,y=map(float,line.replace(',','.').split()[:2]); rows.append((x,y))\n    except ValueError: pass\nprint('points',len(rows),'range',rows[0][0],rows[-1][0])\n# Fixed-width bins: fine below 5000, coarse above.\nbins=list(range(1600,5000,50))+list(range(5000,48000,250))\nfor lo in bins:\n    q=[y for x,y in rows if lo<=x<lo+50 if lo<5000] or [y for x,y in rows if lo<=x<lo+250]\n    if q:\n        print(f'{lo:6d}-{lo+(49 if lo<5000 else 249):6d}: n={len(q):3d} mean={sum(q)/len(q):10.2f} max={max(q):10.2f}')\nPY\n"]
