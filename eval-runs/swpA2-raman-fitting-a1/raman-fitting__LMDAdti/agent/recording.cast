[212.576728, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n    try:\n        x,y=map(float,line.replace(',','.').split()[:2]); p.append((x,y))\n    except ValueError: pass\np=sorted(p)\nprint('bin-center n mean stdev max')\nfor lo in range(1200,3500,25):\n    q=[y for x,y in p if lo<=x<lo+25]\n    if q:\n        m=sum(q)/len(q); sd=(sum((v-m)**2 for v in q)/len(q))**0.5\n        print(f'{lo+12.5:7.1f} {len(q):2d} {m:9.2f} {sd:8.2f} {max(q):9.2f}')\nPY\n"]
