[251.45466, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=sorted((lambda rr:[(float(a.replace(',','.')),float(b.replace(',','.'))) for a,b in rr])(line.split()[:2] for line in Path('graphene.dat').read_text().splitlines() if len(line.split())>=2))\nx=[a for a,b in p]; y=[b for a,b in p]\nw=9\nsm=[]\nfor i in range(len(y)):\n lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))\nc=[]\nfor i in range(len(y)):\n if 1200<=x[i]<=3500 and sm[i]==max(sm[max(0,i-15):min(len(y),i+16)]):\n  c.append(i)\n# Isolate within 30 cm^-1 and show strongest 25.\nout=[]\nfor i in sorted(c,key=lambda k:sm[k],reverse=True):\n if all(abs(x[i]-x[j])>30 for j in out): out.append(i)\nprint('strongest isolated smoothed maxima:')\nfor i in out[:25]: print(f'x={x[i]:9.3f} raw={y[i]:9.2f} smooth={sm[i]:9.2f}')\nfor center,half in [(1585,80),(2700,150)]:\n print('\\nraw around',center)\n for xx,yy in p:\n  if abs(xx-center)<=half and abs((xx*2)%10)<0.01: pass\n q=[(xx,yy) for xx,yy in p if abs(xx-center)<=half]\n # Print every fifth point plus extrema.\n"]
[251.454869, "i", " for xx,yy in q[::5]: print(f'{xx:9.3f} {yy:9.2f}')\n xm,ym=max(q,key=lambda z:z[1]); xn,yn=min(q,key=lambda z:z[1]); print('MAX',xm,ym,'MIN',xn,yn)\nPY\n"]
[251.455025, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
