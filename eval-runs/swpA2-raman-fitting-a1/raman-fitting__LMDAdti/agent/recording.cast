[395.39436, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np=sorted(p)\nprint('1000-unit summaries from 14000 to 19000:')\nfor lo in range(14000,19000,250):\n q=[y for x,y in p if lo<=x<lo+250]\n if q:\n  m=sum(q)/len(q); sd=(sum((v-m)**2 for v in q)/len(q))**.5\n  xm,ym=max(([x,y] for x,y in p if lo<=x<lo+250),key=lambda z:z[1])\n  print(f'{lo:6d}-{lo+249:6d}: n={len(q):3d} mean={m:10.2f} sd={sd:9.2f} max={ym:10.2f} @ {xm:10.3f}')\nPY\n"]
