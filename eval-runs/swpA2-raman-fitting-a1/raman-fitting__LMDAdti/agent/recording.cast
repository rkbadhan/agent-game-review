[123.777718, "i", "python3 - <<'PY'\nfrom pathlib import Path\nrows=[]\nfor n,line in enumerate(Path('graphene.dat').read_text().splitlines(),1):\n    s=line.strip()\n    if not s: continue\n    try: rows.append((n,[float(v.replace(',', '.')) for v in s.split()]))\n    except ValueError: print('header/nonnumeric:',n,repr(line))\nprint('numeric rows:',len(rows),'widths:',sorted({len(v) for _,v in rows}))\nprint('first:',rows[0])\nprint('last:',rows[-1])\nx=[r[0] for _,r in rows]; y=[r[1] for _,r in rows]\nprint(f'x: {min(x):.6f} .. {max(x):.6f}; y: {min(y):.6f} .. {max(y):.6f}')\nprint('x step near start/end:',rows[1][0][0]-rows[0][0][0],rows[-1][0][0]-rows[-2][0][0])\nfor lo,hi,name in [(1500,1700,'near G'),(2500,2900,'near nominal 2D'),(1300,1500,'D region'),(3000,3300,'D+G region')]:\n    pts=[(r[0],r[1]) for _,r in rows if lo<=r[0]<=hi]\n    if pts:\n        xm,ym=max(pts,key=lambda p:p[1])\n        print(f'{name}: n={len(pts)}, max={ym:.4f} at {xm:.4f}, endpoints={pts[0]}, {pts[-1]}')\nfor lo in range(1600,48000,100):\n    q=[r[1] for _,r in r"]
[123.778013, "i", "ows if lo<=r[0]<lo+100]\n    if q:\n        mean=sum(q)/len(q)\n        if mean>max(y)*0.01:\n            print(f'{lo:5d}-{lo+99:5d}: mean={mean:10.2f} max={max(q):10.2f}')\nPY\n"]
