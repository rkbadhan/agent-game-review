[78.862237, "i", "python3 - <<'PY'\nfrom pathlib import Path\nrows=[]\nfor n,line in enumerate(Path('graphene.dat').read_text().splitlines(),1):\n    s=line.strip()\n    if not s:\n        continue\n    try:\n        vals=[float(x.replace(',', '.')) for x in s.split()]\n        rows.append((n,vals))\n    except ValueError:\n        print('header/nonnumeric:',n,repr(line))\nprint('numeric rows:',len(rows),'widths:',sorted({len(v) for _,v in rows}))\nprint('first:',rows[0],'\nlast:',rows[-1])\nx=[r[0] for _,r in rows]; y=[r[1] for _,r in rows]\nprint(f'x: {min(x):.6f} .. {max(x):.6f}; y: {min(y):.6f} .. {max(y):.6f}')\nfor lo,hi,name in [(1500,1650,'G region'),(2550,2850,'2D region'),(1300,1450,'D region')]:\n    pts=[(r[0],r[1]) for _,r in rows if lo<=r[0]<=hi]\n    if pts:\n        xm,ym=max(pts,key=lambda p:p[1])\n        print(f'{name}: n={len(pts)}, max y={ym:.4f} at x={xm:.4f}, endpoints={pts[0], pts[-1]}')\n# Print coarse block averages to reveal baseline and broad features.\nfor lo in range(min(map(lambda z:int(z//100*100),x)),max(x)+1,100):\n "]
[78.862431, "i", "   q=[r[1] for _,r in rows if lo<=r[0]<lo+100]\n    if q:\n        print(f'{lo:4d}-{lo+99:4d}: mean={sum(q)/len(q):10.2f} max={max(q):10.2f}')\nPY\n"]
