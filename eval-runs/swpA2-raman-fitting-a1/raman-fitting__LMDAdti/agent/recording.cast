[565.84457, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort()\nfor lo,hi,title in [(1540,1900,'G candidate'),(2450,2850,'nominal 2D candidate')]:\n q=[(x,y) for x,y in p if lo<=x<=hi]\n print('\\n---',title,'every point sorted ascending ---')\n for x,y in q: print(f'{x:12.6f} {y:12.6f}')\nPY\n"]
[565.844888, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
