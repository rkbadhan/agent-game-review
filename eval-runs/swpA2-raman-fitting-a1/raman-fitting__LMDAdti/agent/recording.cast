[396.400975, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np=sorted(p); x=[a for a,b in p]; y=[b for a,b in p]\nw=21\nsm=[]\nfor i in range(len(y)):\n lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))\nc=[]\nfor i in range(1,len(y)-1):\n if 14500<=x[i]<=18500 and sm[i]>=sm[i-1] and sm[i]>=sm[i+1]: c.append(i)\nout=[]\nfor i in sorted(c,key=lambda k:sm[k],reverse=True):\n if all(abs(x[i]-x[j])>25 for j in out): out.append(i)\nprint('strongest isolated maxima, 14500-18500:')\nfor i in out[:30]: print(f'x={x[i]:11.4f} raw={y[i]:10.2f} smooth={sm[i]:10.2f}')\n# Laser conversions\nfor lam in (514.5,532,633,785): print(lam,'nm =',1e7/lam,'cm^-1')\nfor laser in (1e7/532,1e7/514.5,1e7/633):\n print('laser',laser,'=> G',laser-1580,'2D',laser-2700)\nPY\n"]
