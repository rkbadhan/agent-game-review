[250.453543, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n    try:\n        a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n    except ValueError: pass\np=sorted(p)\nfor lo in range(1200,3500,50):\n    q=[y for x,y in p if lo<=x<lo+50]\n    if q:\n        m=sum(q)/len(q)\n        bar='#'*max(1,int(m/100))\n        print(f'{lo:4d}-{lo+49:4d} {m:8.1f} {max(q):8.1f} {bar}')\nPY\n"]
