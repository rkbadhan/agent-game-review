[565.94803, "o", "\u001b[?2004hroot@1eb0bf4552f6:/app# "]
[628.968868, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort()\nfor lo,hi,name in [(5200,5750,'G region'),(5850,6300,'2D region')]:\n print('\\n',name)\n for lo2 in range(lo,hi,25):\n  q=[y for x,y in p if lo2<=x<lo2+25]\n  if q:\n   m=sum(q)/len(q); sd=(sum((v-m)**2 for v in q)/len(q))**.5\n   print(f'{lo2:4d}-{lo2+24:4d}: n={len(q):2d} mean={m:9.2f} sd={sd:8.2f} max={max(q):9.2f}')\nPY\n"]
[628.969112, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[628.969242, "o", "\u001b[?2004h> "]
[628.96943, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[628.969505, "o", "\u001b[?2004h> "]
[628.969548, "o", "p=[]\r\n\u001b[?2004l\r"]
[628.969778, "o", "\u001b[?2004h> "]
[628.969983, "o", "for line in Path('graphene.dat').read_text().splitlines():\r\n\u001b[?2004l\r"]
[628.970163, "o", "\u001b[?2004h>  try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[628.970393, "o", "> "]
[628.970692, "o", "  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\r\n\u001b[?2004l\r\u001b[?2004h"]
[628.970822, "o", "> "]
[628.971123, "o", " except ValueError: pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[628.971245, "o", "p.sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[628.971421, "o", "> "]
