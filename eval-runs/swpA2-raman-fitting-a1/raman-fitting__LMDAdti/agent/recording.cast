[858.503356, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort(); x=[a for a,b in p]; y=[b for a,b in p]\nw=11\nsm=[]\nfor i in range(len(y)):\n lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))\ndef med(v):\n v=sorted(v); return v[len(v)//2] if v else None\nfor name,cen in [('G',7034),('2D',7645)]:\n inds=[i for i in range(len(x)) if cen-300<=x[i]<=cen+300]\n # Search only central 400 A, ensuring sidebands exist.\n search=[i for i in inds if cen-200<=x[i]<=cen+200]\n im=max(search,key=lambda i:sm[i])\n lm=med([y[j] for j in inds if 120<=x[im]-x[j]<=300])\n rm=med([y[j] for j in inds if 120<=x[j]-x[im]<=300])\n print('\\n'+name, 'max', f'x={x[im]:.4f}', f'raw={y[im]:.2f}', f'smooth={sm[im]:.2f}', 'left/right med',lm,rm)\n if lm and rm:\n  target=(sm[im]+min(lm,rm))/2\n  li=im\n  while li>inds[0] and sm[li]>target: li-=1\n  ri=im\n  while ri<inds[-1] and s"]
[858.503695, "i", "m[ri]>target: ri+=1\n  print('half-height crossings/FWHM:',x[li],x[ri],x[ri]-x[li])\n print('nearby samples:')\n for j in inds:\n  if abs(x[j]-x[im])<=180: print(f'{x[j]:11.4f} {y[j]:10.2f} {sm[j]:10.2f}')\nPY\n"]
