[792.373021, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort(); x=[a for a,b in p]; y=[b for a,b in p]\nw=11\nsm=[]\nfor i in range(len(y)):\n lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))\nfor name,pred in [('G',7033),('2D',7634)]:\n inds=[i for i in range(len(x)) if pred-250<=x[i]<=pred+250]\n im=max(inds,key=lambda i:sm[i])\n # side medians 100--300 A away\n def med(vals):\n  v=sorted(vals); return v[len(v)//2]\n lm=med([y[j] for j in inds if 100<=x[im]-x[j]<=300]); rm=med([y[j] for j in inds if 100<=x[j]-x[im]<=300])\n print('\\n',name,'predicted',pred,'smoothed max',x[im],y[im],sm[im],'side medians',lm,rm)\n target=(sm[im]+min(lm,rm))/2\n li=im\n while li>inds[0] and sm[li]>target:li-=1\n ri=im\n while ri<inds[-1] and sm[ri]>target:ri+=1\n print('FWHM estimate',x[ri]-x[li], 'crossings',x[li],x[ri])\n for j in inds:\n  if abs(x[j]-x[im])<=150: p"]
[792.373232, "i", "rint(f'{x[j]:11.4f} {y[j]:10.2f} smooth={sm[j]:10.2f}')\nPY\n"]
