[41.846961, "i", "python3 - <<'PY'\nfrom pathlib import Path\nrows=[]\nfor n,line in enumerate(Path('graphene.dat').read_text().splitlines(),1):\n    s=line.strip()\n    if not s:\n        continue\n    try:\n        rows.append((n,[float(x) for x in s.split()]))\n    except ValueError:\n        print('NONNUMERIC', n, repr(line))\nprint('numeric rows:',len(rows))\nif rows:\n    width=sorted({len(r) for _,r in rows})\n    print('row widths:',width)\n    a=rows[0][1]; b=rows[-1][1]\n    print('first:',rows[0]); print('last:',rows[-1])\n    for j in range(min(width)):\n        vals=[r[j] for _,r in rows if len(r)>j]\n        print(f'col {j}: min={min(vals):.12g} max={max(vals):.12g} mean={sum(vals)/len(vals):.12g}')\nPY\n"]
