[857.508749, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort()\nfor lo,hi,name in [(6800,7300,'G window'),(7350,7900,'2D window')]:\n print('\\n---',name,'20-A bins ---')\n for lo2 in range(lo,hi,20):\n  q=[y for x,y in p if lo2<=x<lo2+20]\n  if q:\n   m=sum(q)/len(q); sd=(sum((v-m)**2 for v in q)/len(q))/len(q); sd**=.5\n   xm,ym=max(((x,y) for x,y in p if lo2<=x<lo2+20),key=lambda z:z[1])\n   print(f'{lo2:4d}-{lo2+19:4d} n={len(q):2d} mean={m:8.1f} sd={sd:7.1f} max={ym:8.1f}@{xm:8.1f}')\nPY\n"]
