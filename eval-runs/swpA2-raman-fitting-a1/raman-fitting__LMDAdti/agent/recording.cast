[329.295751, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np=sorted(p); x=[a for a,b in p]; y=[b for a,b in p]\n# Quadratic local smoothing over roughly 31 points.\nw=31; sm=[]\nfor i in range(len(y)):\n lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))\n# Local maxima and approximate prominence over nearest significant minima.\nc=[]\nfor i in range(1,len(y)-1):\n if sm[i]>=sm[i-1] and sm[i]>=sm[i+1]: c.append(i)\nout=[]\nfor i in sorted(c,key=lambda k:sm[k],reverse=True):\n if all(abs(x[i]-x[j])>50 for j in out): out.append(i)\nprint('isolated smoothed maxima (strongest first):')\nfor i in out[:40]:\n l=sm[:i]; r=sm[i+1:]\n # prominence relative to higher of the minimum-to-left/right saddle approximations\n pl=sm[i]-min(l) if l else 0; pr=sm[i]-min(r) if r else 0\n print(f'i={i:4d} x={x[i]:10.3f} raw={y[i]:10.2f} smooth={sm[i]:10.2f} left_prom={pl:10.2f"]
[329.295969, "i", "} right_prom={pr:10.2f}')\nimax=max(range(len(y)),key=y.__getitem__)\nprint('GLOBAL RAW MAX',x[imax],y[imax])\n# Spacing samples.\nfor k in [0,1,2,10,100,500,1000,2000,3000,3563]:\n print('spacing at row',k+1,x[k+1]-x[k])\nPY\n"]
