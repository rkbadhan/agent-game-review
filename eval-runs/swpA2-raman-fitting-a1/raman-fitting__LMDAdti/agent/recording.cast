[718.722803, "o", "\u001b[?2004h> for i in range(len(x)):\r\n\u001b[?2004l\r\u001b[?2004h>  if 5200<=x[i]<=6280:\r\n\u001b[?2004l\r\u001b[?2004h>   neigh=[j for j in range(max(0,i-12),min(len(x),i+13))]\r\n\u001b[?2004l\r\u001b[?2004h>   if sm[i]==max(sm[j] for j in neigh): c.append(i)\r\n\u001b[?2004l\r"]
