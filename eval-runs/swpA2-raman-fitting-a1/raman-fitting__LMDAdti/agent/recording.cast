[328.267542, "i", "python3 - <<'PY' > /tmp/bins.txt\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np=sorted(p)\nfor lo in range(1600,48000,100):\n q=[y for x,y in p if lo<=x<lo+100]\n if q:\n  print(f'{lo:5d} {sum(q)/len(q):10.2f} {max(q):10.2f} {len(q):3d}')\nPY\nwc -l /tmp/bins.txt; sed -n '1,120p' /tmp/bins.txt\n"]
