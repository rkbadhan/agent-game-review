[170.908275, "o", "\u001b[?2004hroot@1eb0bf4552f6:/app# "]
[171.504881, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n    try: p.append(tuple(map(float,line.replace(',','.').split()[:2])))\n    except: pass\n# Sort by x for smoothing/rank diagnostics.\np=sorted(p)\nx=[a for a,b in p]; y=[b for a,b in p]\n# Moving-average extrema using several window sizes.\nfor w in (5,11,21):\n    z=[]\n    for i in range(len(y)):\n        lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); z.append(sum(y[lo:hi])/(hi-lo))\n    inds=sorted(sorted(range(len(z)),key=z.__getitem__,reverse=True)[:30])\n    print('\\nwindow',w,'top smoothed candidates:')\n    out=[]\n    for i in inds:\n        # Keep one candidate per 20-point neighborhood.\n        if all(abs(x[i]-x[j])>20 for j in out): out.append(i)\n    for i in out[:15]: print(f'x={x[i]:10.3f} raw={y[i]:10.2f} smooth={z[i]:10.2f}')\nPY\n"]
[171.505159, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[171.505474, "o", "\u001b[?2004h> "]
[171.505622, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p=[]\r\n\u001b[?2004l\r"]
[171.505768, "o", "\u001b[?2004h> "]
[171.506186, "o", "for line in Path('graphene.dat').read_text().splitlines():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.506445, "o", "    try: p.append(tuple(map(float,line.replace(',','.').split()[:2])))\r\n\u001b[?2004l\r"]
[171.506511, "o", "\u001b[?2004h>     except: pass\r\n"]
[171.506531, "o", "\u001b[?2004l\r"]
[171.506577, "o", "\u001b[?2004h"]
[171.506654, "o", "> "]
[171.509896, "o", "# Sort by x for smoothing/rank diagnostics.\r\n\u001b[?2004l\r"]
[171.510229, "o", "\u001b[?2004h> "]
[171.511964, "o", "p=sorted(p)\r\n\u001b[?2004l\r"]
[171.512122, "o", "\u001b[?2004h> "]
[171.512395, "o", "x=[a for a,b in p]; y=[b for a,b in p]\r\n\u001b[?2004l\r"]
[171.513023, "o", "\u001b[?2004h"]
[171.513122, "o", "> "]
[171.514058, "o", "# Moving-average extrema using several window sizes.\r\n\u001b[?2004l\r"]
[171.51486, "o", "\u001b[?2004h> for w in (5,11,21):\r\n\u001b[?2004l\r"]
[171.515498, "o", "\u001b[?2004h>     z=[]\r\n\u001b[?2004l\r\u001b[?2004h>     for i in range(len(y)):\r\n\u001b[?2004l\r\u001b[?2004h>         lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); z.append(sum(y[lo:hi])/(hi-lo))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.516224, "o", "    inds=sorted(sorted(range(len(z)),key=z.__getitem__,reverse=True)[:30])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.516642, "o", "    print('\\nwindow',w,'top smoothed candidates:')\r\n\u001b[?2004l\r\u001b[?2004h>     out=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.517282, "o", "    for i in inds:\r\n\u001b[?2004l\r\u001b[?2004h>         # Keep one candidate per 20-point neighborhood.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.517936, "o", "        if all(abs(x[i]-x[j])>20 for j in out): out.append(i)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[171.518479, "o", "    for i in out[:15]: print(f'x={x[i]:10.3f} raw={y[i]:10.2f} smooth={z[i]:10.2f}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
