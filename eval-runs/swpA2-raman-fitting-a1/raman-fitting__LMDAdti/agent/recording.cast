[718.717975, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort(); x=[a for a,b in p]; y=[b for a,b in p]\nw=9\nsm=[]\nfor i in range(len(y)):\n lo=max(0,i-w//2); hi=min(len(y),i+w//2+1); sm.append(sum(y[lo:hi])/(hi-lo))\nc=[]\nfor i in range(len(x)):\n if 5200<=x[i]<=6280:\n  neigh=[j for j in range(max(0,i-12),min(len(x),i+13))]\n  if sm[i]==max(sm[j] for j in neigh): c.append(i)\nout=[]\nfor i in sorted(c,key=lambda k:sm[k],reverse=True):\n if all(abs(x[i]-x[j])>20 for j in out): out.append(i)\nprint('isolated smoothed maxima below 6280:')\nfor i in out[:30]:\n # robust side medians 80--250 A away\n l=sorted(y[j] for j in range(len(x)) if 80<=x[i]-x[j]<=250)\n r=sorted(y[j] for j in range(len(x)) if 80<=x[j]-x[i]<=250)\n bl=l[len(l)//2] if l else float('nan'); br=r[len(r)//2] if r else float('nan')\n print(f'x={x[i]:10.4f} raw={y[i]:9.1f} smooth={sm[i]:9.1f} leftmed={bl:8.1f} "]
[718.718225, "i", "rightmed={br:8.1f}')\nPY\n"]
