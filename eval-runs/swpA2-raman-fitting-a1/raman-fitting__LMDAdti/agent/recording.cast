[859.471241, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=[]\nfor line in Path('graphene.dat').read_text().splitlines():\n try:\n  a,b=line.replace(',','.').split()[:2]; p.append((float(a),float(b)))\n except ValueError: pass\np.sort()\nlaser=1e7/6328\n# Summarize converted Raman shifts in 20 cm^-1 bins.\nprint('Raman-shift bins (using 632.8 nm):')\nfor lo in range(1300,3100,50):\n q=[y for x,y in p if lo <= laser-1e7/x < lo+50]\n if q:\n  m=sum(q)/len(q)\n  print(f'{lo:4d}-{lo+49:4d}: n={len(q):3d} mean={m:9.1f} max={max(q):9.1f}')\nPY\n"]
[859.471502, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
