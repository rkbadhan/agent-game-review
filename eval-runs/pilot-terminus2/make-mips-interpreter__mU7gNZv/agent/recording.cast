[307.026955, "i", "python3 - <<'PY'\nimport re\ns=open('/tmp/vm.dis').read().splitlines()\nfor i,l in enumerate(s):\n if '\\tsyscall' in l:\n  nums=[]\n  for x in s[max(0,i-15):i+2]:\n   m=re.search(r'(?:li|addiu)\\s+\\$2, \\$zero, ([0-9]+)',x)\n   if m: nums.append(int(m.group(1)))\n  print(l.strip(), 'candidate_number='+str(nums[-1] if nums else None))\nPY\n"]
