[492.898971, "o", "awk++%10 == 0) {\r\n   175\t    writeBMPFile(\"/tmp/frame.bmp\", (uint32_t*)DG_ScreenBuffer, DOOMGENERIC_RESX, DOOMGENERIC_RESY);\r\n   176\t  }\r\n   177\t    \r\n   178\t    // Handle keyboard input if needed\r\n   179\t    // This would need to be replaced with a different input method\r\n   180\t    // since we're not using X11 anymore\r\n   181\t}\r\n   182\t\r\n   183\tvoid DG_SleepMs(uint32_t ms)\r\n   184\t{\r\n   185\t    // Spinloop implementation for sleep using inline assembly\r\n   186\t    // Assuming 3GHz processor (3 billion cycles per second)\r\n   187\t    // 1ms = 3 million cycles\r\n   188\t    uint64_t cycles_per_ms = 3;\r\n   189\t    uint64_t total_cycles = cycles_per_ms * ms;\r\n   190\t    \r\n   191\t    volatile uint64_t i;\r\n   192\t    for (i = 0; i < total_cycles; i++)\r\n   193\t    {\r\n   194\t        // Use volatile inline assembly to ensure the loop isn't optimized away\r\n   195\t        __asm__ volatile(\"\" ::: \"memory\");\r\n   196\t    }\r\n   197\t}\r\n   198\t\r\n   199\tint ms_ctr = 0;;\r\n   200\tuint32_t DG_GetTicksMs()\r\n   201\t{\r\n   202\t    ret"]
