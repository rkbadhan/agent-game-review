[492.89845, "o", "   102\t    if (!bmp) {\r\n   103\t        fprintf(stderr, \"Memory allocation failed\\n\");\r\n   104\t        return;\r\n   105\t    }\r\n   106\t\r\n   107\t    bmp = bmp+2;\r\n   108\t    \r\n   109\t    // Use uint32_t array for headers (with proper byte offsets)\r\n   110\t    uint16_t* signature = (uint16_t*)bmp;\r\n   111\t    uint32_t* header = (uint32_t*)(bmp + 2);\r\n   112\t    \r\n   113\t    // File header (14 bytes)\r\n   114\t    *signature = 0x4D42;                      // 'BM' in little-endian\r\n   115\t    header[0] = file_size;                    // File size\r\n   116\t    header[1] = 0;                            // Reserved\r\n   117\t    header[2] = 54;                           // Offset to pixel data\r\n   118\t    \r\n   119\t    // DIB header (40 bytes)\r\n   120\t    header[3] = 40;                           // DIB header size\r\n   121\t    header[4] = width;                        // Width\r\n   122\t    header[5] = -height;                      // Height (negative for top-down)\r\n   123\t    \r\n   124\t    // Color planes (16-bit) and bits per"]
[492.898677, "o", " pixel (16-bit)\r\n   125\t    uint16_t* color_data = (uint16_t*)(bmp + 26);\r\n   126\t    color_data[0] = 1;                        // Color planes\r\n   127\t    color_data[1] = 32;                       // Bits per pixel (32-bit BGRA)\r\n   128\t    \r\n   129\t    header[7] = 0;                            // No compression\r\n   130\t    header[8] = image_size;                   // Image size\r\n   131\t    header[9] = 0;                            // X pixels per meter\r\n   132\t    header[10] = 0;                           // Y pixels per meter\r\n   133\t    header[11] = 0;                           // Total colors\r\n   134\t    header[12] = 0;                           // Important colors\r\n   135\t    \r\n   136\t    // Write pixel data directly (convert RGBA to BGRA)\r\n   137\t    uint32_t* pixel_data = (uint32_t*)(bmp + 54);\r\n   138\t    for (int y = 0; y < height; y++) {\r\n   139\t        for (int x = 0; x < width; x++) {\r\n   140\t            uint32_t pixel = buffer[y * width + x];\r\n   141\t            // Swap R and B (RGBA to BGRA)\r\n "]
