[493.528054, "i", "python3 - <<'PY'\nimport re,collections\nops=collections.Counter()\nfor l in open('/tmp/vm.dis'):\n m=re.search(r'^\\s*[0-9a-f]+:\\s+(?:nop|[^\\s]+\\s+)?([^\\s]+)',l)\n if m: ops[m.group(1).split('<')[0]]+=1\nfor op,n in ops.most_common(): print(f'{n:6} {op}')\nPY\n"]
