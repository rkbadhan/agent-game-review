[493.211139, "o", "930:void* calloc(size_t nmemb, size_t size) {\r\n949:#define HEAP_SIZE (1024 * 1024 * 1024)  // 1 GB static heap\r\n950:static unsigned char heap[HEAP_SIZE] __attribute__((aligned(64)));  // Cache line aligned\r\n951:static size_t heap_pos = 0;  // Current position in the heap\r\n955:static void* free_lists[NUM_SIZE_CLASSES] = {NULL};\r\n996:void* basic_malloc(size_t size) {\r\n1044:    // No free block found, allocate from the heap\r\n1045:    if (heap_pos + total_size > HEAP_SIZE)\r\n1048:    // Create a new block at the current heap position\r\n1049:    block_header_t* new_block = (block_header_t*)(heap + heap_pos);\r\n1051:    heap_pos += total_size;\r\n1065:    if ((void*)block < (void*)heap || (void*)block >= (void*)(heap + heap_pos))\r\n1097:        // Allocate pool from the heap\r\n1098:        fixed_pools[i].memory = heap + heap_pos;\r\n1110:        heap_pos += pool_size;\r\n1117:static void* fixed_malloc(size_t size) {\r\n1164:void* malloc(size_t size) {\r\n1179:void* realloc(void* ptr, size_t size) {\r\n"]
