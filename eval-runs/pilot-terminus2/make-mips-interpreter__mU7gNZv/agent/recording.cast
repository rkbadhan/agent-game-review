[98.970932, "o", "\t};\r\n    43\t\r\n    44\tstatic unsigned char convertToDoomKey(unsigned char scancode)\r\n    45\t{\r\n    46\t    unsigned char key = 0;\r\n    47\t\r\n    48\t    switch (scancode)\r\n    49\t    {\r\n    50\t    case 0x9C:\r\n    51\t    case 0x1C:\r\n    52\t        key = KEY_ENTER;\r\n    53\t        break;\r\n    54\t    case 0x01:\r\n    55\t        key = KEY_ESCAPE;\r\n    56\t        break;\r\n    57\t    case 0xCB:\r\n    58\t    case 0x4B:\r\n    59\t        key = KEY_LEFTARROW;\r\n    60\t        break;\r\n    61\t    case 0xCD:\r\n    62\t    case 0x4D:\r\n    63\t        key = KEY_RIGHTARROW;\r\n    64\t        break;\r\n    65\t    case 0xC8:\r\n    66\t    case 0x48:\r\n    67\t        key = KEY_UPARROW;\r\n    68\t        break;\r\n    69\t    case 0xD0:\r\n    70\t    case 0x50:\r\n    71\t        key = KEY_DOWNARROW;\r\n    72\t        break;\r\n    73\t    case 0x1D:\r\n"]
[98.972493, "o", "    74\t        key = KEY_FIRE;\r\n    75\t        break;\r\n    76\t    case 0x39:\r\n    77\t        key = KEY_USE;\r\n    78\t        break;\r\n    79\t    case 0x2A:\r\n    80\t    case 0x36:\r\n    81\t        key = KEY_RSHIFT;\r\n    82\t        break;\r\n    83\t    case 0x15:\r\n    84\t        key = 'y';\r\n    85\t        break;\r\n    86\t    default:\r\n    87\t        break;\r\n    88\t    }\r\n    89\t\r\n    90\t    return key;\r\n    91\t}\r\n    92\t\r\n    93\tstatic void addKeyToQueue(int pressed, unsigned char keyCode)\r\n    94\t{\r\n    95\t\t//printf(\"key hex %x decimal %d\\n\", keyCode, keyCode);\r\n    96\t\r\n    97\t        unsigned char key = convertToDoomKey(keyCode);\r\n    98\t\r\n    99\t        unsigned short keyData = (pressed << 8) | key;\r\n   100\t\r\n   101\t        s_KeyQueue[s_KeyQueueWriteIndex] = keyData;\r\n   102\t        s_KeyQueueWriteIndex++;\r\n   103\t        s_KeyQueueWriteIndex %= KEYQUEUE_SIZE;\r\n   104\t}\r\n   105\t\r\n   106\t\r\n   107\tstruct termios orig_termios;\r\n   108\t\r\n   109\tvoid disableRawMode()\r\n   110\t{\r\n   111\t  //printf(\"returning original te"]
[98.973423, "o", "rmios\\n\");\r\n   112\t  tcsetattr(STDIN_FILENO, TCSAFLUSH, &orig_termios);\r\n   113\t}\r\n   114\t\r\n   115\tvoid enableRawMode()\r\n   116\t{\r\n   117\t  tcgetattr(STDIN_FILENO, &orig_termios);\r\n   118\t  atexit(disableRawMode);\r\n   119\t  struct termios raw = orig_termios;\r\n   120\t  raw.c_lflag &= ~(ECHO);\r\n   121\t  raw.c_cc[VMIN] = 0;\r\n   122\t  tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);\r\n   123\t}\r\n   124\t\r\n   125\tvoid DG_Init()\r\n   126\t{\r\n   127\t    FrameBufferFd = open(\"/dev/fb0\", 0);\r\n   128\t\r\n   129\t    if (FrameBufferFd >= 0)\r\n   130\t    {\r\n   131\t        printf(\"Getting screen width...\");\r\n   132\t        s_ScreenWidth = ioctl(FrameBufferFd, FB_GET_WIDTH);\r\n   133\t        printf(\"%d\\n\", s_ScreenWidth);\r\n   134\t\r\n   135\t        printf(\"Getting screen height...\");\r\n   136\t        s_ScreenHeight = ioctl(FrameBufferFd, FB_GET_HEIGHT);\r\n   137\t        printf(\"%d\\n\", s_ScreenHeight);\r\n   138\t\r\n   139\t        if (0 == s_ScreenWidth || 0 == s_ScreenHeight)\r\n   140\t        {\r\n   141\t            printf(\"Unable to obtain screen in"]
[98.973739, "o", "fo!\");\r\n   142\t            exit(1);\r\n   143\t        }\r\n   144\t\r\n   145\t        FrameBuffer = mmap(NULL, s_ScreenWidth * s_ScreenHeight * 4, PROT_READ | PROT_WRITE, 0, FrameBufferFd, 0);\r\n   146\t\r\n   147\t        if (FrameBuffer != (int*)-1)\r\n   148\t        {\r\n   149\t            printf(\"FrameBuffer mmap success\\n\");\r\n   150\t        }\r\n   151\t        else\r\n   152\t        {\r\n   153\t            printf(\"FrameBuffermmap failed\\n\");\r\n   154\t        }\r\n   155\t    }\r\n   156\t    else\r\n   157\t    {\r\n   158\t        printf(\"Opening FrameBuffer device failed!\\n\");\r\n   159\t    }\r\n   160\t\r\n   161\t    enableRawMode();\r\n   162\t\r\n   163\t    KeyboardFd = open(\"/dev/keyboard\", 0);\r\n   164\t\r\n   165\t    if (KeyboardFd >= 0)\r\n   166\t    {\r\n   167\t        //enter non-blocking mode\r\n   168\t        ioctl(KeyboardFd, 1, (void*)1);\r\n   169\t    }\r\n   170\t\r\n   171\t    int argPosX = 0;\r\n   172\t    int argPosY = 0;\r\n   173\t\r\n   174\t    argPosX = M_CheckParmWithArgs(\"-posx\", 1);\r\n   175\t    if (argPosX > 0)\r\n   176\t    {\r\n   177\t        sscanf"]
[98.973781, "o", "(myargv[argPosX + 1], \"%d\", &s_PositionX);\r\n   178\t    }\r\n   179\t\r\n   180\t    argPosY = M_CheckParmWithArgs(\"-posy\", 1);\r\n   181\t    if (argPosY > 0)\r\n   182\t    {\r\n   183\t        sscanf(myargv[argPosY + 1], \"%d\", &s_PositionY);\r\n   184\t    }\r\n   185\t}\r\n   186\t\r\n   187\tstatic void handleKeyInput()\r\n   188\t{\r\n   189\t    if (KeyboardFd < 0)\r\n   190\t    {\r\n   191\t        return;\r\n   192\t    }\r\n   193\t\r\n   194\t    unsigned char scancode = 0;\r\n   195\t\r\n   196\t    if (read(KeyboardFd, &scancode, 1) > 0)\r\n   197\t    {\r\n   198\t        unsigned char keyRelease = (0x80 & scancode);\r\n   199\t\r\n   200\t        scancode = (0x7F & scancode);\r\n   201\t\r\n   202\t        //printf(\"scancode:%x pressed:%d\\n\", scancode, 0 == keyRelease);\r\n   203\t\r\n   204\t        if (0 == keyRelease)\r\n   205\t        {\r\n   206\t            addKeyToQueue(1, scancode);\r\n   207\t        }\r\n   208\t        else\r\n   209\t        {\r\n   210\t            addKeyToQueue(0, scancode);\r\n   211\t        }\r\n   212\t    }\r\n   213\t}\r\n   214\t\r\n   215\tvoid DG_DrawFrame()\r\n   "]
[98.973831, "o", "216\t{\r\n   217\t    if (FrameBuffer)\r\n   218\t    {\r\n   219\t        for (int i = 0; i < DOOMGENERIC_RESY; ++i)\r\n   220\t        {\r\n   221\t            memcpy(FrameBuffer + s_PositionX + (i + s_PositionY) * s_ScreenWidth, DG_ScreenBuffer + i * DOOMGENERIC_RESX, DOOMGENERIC_RESX * 4);\r\n   222\t        }\r\n   223\t    }\r\n   224\t\r\n   225\t    handleKeyInput();\r\n   226\t}\r\n   227\t\r\n   228\tvoid DG_SleepMs(uint32_t ms)\r\n   229\t{\r\n   230\t    sleep_ms(ms);\r\n   231\t}\r\n   232\t\r\n   233\tuint32_t DG_GetTicksMs()\r\n   234\t{\r\n   235\t    return get_uptime_ms();\r\n   236\t}\r\n   237\t\r\n   238\tint DG_GetKey(int* pressed, unsigned char* doomKey)\r\n   239\t{\r\n   240\t    if (s_KeyQueueReadIndex == s_KeyQueueWriteIndex)\r\n   241\t    {\r\n   242\t        //key queue is empty\r\n   243\t\r\n   244\t        return 0;\r\n   245\t    }\r\n   246\t    else\r\n   247\t    {\r\n   248\t        unsigned short keyData = s_KeyQueue[s_KeyQueueReadIndex];\r\n   249\t        s_KeyQueueReadIndex++;\r\n   250\t        s_KeyQueueReadIndex %= KEYQUEUE_SIZE;\r\n   251\t\r\n   252\t        *pressed = "]
