[519.994784, "o", "   135\t#define O_EXCL 128\r\n   136\t#define O_TRUNC 512\r\n   137\t#define O_APPEND 1024\r\n   138\t\r\n   139\t// Seek whence values\r\n   140\t#define SEEK_SET 0\r\n   141\t#define SEEK_CUR 1\r\n   142\t#define SEEK_END 2\r\n   143\t\r\n   144\t// Error codes (compatible with standard C/POSIX)\r\n   145\t#define ENOENT 2       // No such file or directory\r\n   146\t#define EEXIST 17      // File exists\r\n   147\t#define EISDIR 21      // Is a directory\r\n   148\t#define ENOTDIR 20     // Not a directory\r\n   149\t#define EMFILE 24      // Too many open files\r\n   150\t#define EINVAL 22      // Invalid argument\r\n   151\t#define EBADF 9        // Bad file descriptor\r\n   152\t#define ENOTEMPTY 39   // Directory not empty\r\n   153\t#define ENOMEM 12      // Out of memory\r\n   154\t#define EBUSY 16       // Device or resource busy\r\n   155\t\r\n   156\t// Forward declarations\r\n   157\tstruct FileNode;\r\n   158\ttypedef unsigned int mode_t;\r\n   159\ttypedef long off_t;\r\n   160\ttypedef long ssize_t;\r\n   161\t\r\n   162\t// Directory entry\r\n   163\ttypedef struct {\r\n   164"]
[519.994826, "o", "\t    char name[MAX_PATH_LENGTH];\r\n   165\t    struct FileNode* node;\r\n   166\t} DirEntry;\r\n   167\t\r\n   168\t// File node structure\r\n   169\ttypedef struct FileNode {\r\n   170\t    char name[MAX_PATH_LENGTH];\r\n   171\t    int type;               // Regular file or directory\r\n   172\t    time_t created;         // Creation time\r\n   173\t    time_t modified;        // Last modification time\r\n   174\t    time_t accessed;        // Last access time\r\n   175\t    \r\n   176\t    // File content\r\n   177\t    unsigned char* data;    // File data for regular files\r\n   178\t    size_t size;            // Current file size\r\n   179\t    size_t capacity;        // Allocated capacity\r\n   180\t    \r\n   181\t    // Directory content\r\n   182\t    DirEntry* entries;      // Directory entries for directories\r\n   183\t    size_t num_entries;     // Number of entries\r\n   184\t    size_t max_entries;     // Max entries allocated\r\n   185\t    \r\n   186\t    struct FileNode* parent; // Parent directory\r\n   187\t} FileNode;\r\n   188\t\r\n   189\t// File descriptor "]
[519.994865, "o", "structure\r\n   190\ttypedef struct {\r\n   191\t    FileNode* node;\r\n   192\t    size_t position;\r\n   193\t    int mode;               // Read/write mode\r\n   194\t    bool used;              // Whether this file descriptor is in use\r\n   195\t} FileDescriptor;\r\n   196\t\r\n   197\t// Global filesystem state\r\n   198\tstatic FileNode* root = NULL;\r\n   199\tstatic FileDescriptor fd_table[MAX_FILE_DESCRIPTORS];\r\n   200\t\r\n   201\t\r\n   202\tFileNode* create_node(const char* name, int type, FileNode* parent);\r\n   203\t\r\n   204\t// Helper function to initialize the filesystem\r\n   205\tvoid init_filesystem() {\r\n   206\t    // Create root directory if it doesn't exist\r\n   207\t    if (root == NULL) {\r\n   208\t        root = (FileNode*)malloc(sizeof(FileNode));\r\n   209\t        strcpy(root->name, \"/\");\r\n   210\t        root->type = FILE_TYPE_DIRECTORY;\r\n   211\t        root->created = root->modified = root->accessed = time(NULL);\r\n   212\t        root->data = NULL;\r\n   213\t        root->size = 0;\r\n   214\t        root->capacity = 0;\r\n   215\t       "]
[519.995398, "o", " root->entries = (DirEntry*)malloc(10 * sizeof(DirEntry));\r\n   216\t        root->num_entries = 0;\r\n   217\t        root->max_entries = 10;\r\n   218\t        root->parent = root; // Root is its own parent\r\n   219\t        \r\n   220\t        // Initialize file descriptor table\r\n   221\t        for (int i = 0; i < MAX_FILE_DESCRIPTORS; i++) {\r\n   222\t            if (i < 5) {\r\n   223\t                fd_table[i].used = 1;  // Reserve file descriptors 0-4\r\n   224\t                fd_table[i].node = NULL;\r\n   225\t            } else {\r\n   226\t                fd_table[i].used = 0;\r\n   227\t            }\r\n   228\t        }\r\n   229\t        \r\n   230\t        // Load doom.wad from the real filesystem\r\n   231\t        const char* wad_path = \"doom.wad\";\r\n   232\t        \r\n   233\t        // Open the WAD file from the real filesystem\r\n   234\t        int real_fd = real_syscall6(SYS_open, (long)wad_path, O_RDONLY, 0, 0, 0, 0);\r\n"]
[519.995543, "o", "   235\t        if (real_fd >= 0) {\r\n   236\t            // Get the file size\r\n   237\t            off_t file_size = real_syscall6(SYS_lseek, real_fd, 0, SEEK_END, 0, 0, 0);\r\n   238\t            real_syscall6(SYS_lseek, real_fd, 0, SEEK_SET, 0, 0, 0); // Reset to beginning\r\n   239\t            \r\n   240\t            if (file_size > 0 && file_size <= MAX_FILE_SIZE) {\r\n"]
