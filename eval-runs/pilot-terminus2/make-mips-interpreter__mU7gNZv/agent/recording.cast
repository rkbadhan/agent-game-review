[493.216325, "o", "   192\t    size_t position;\r\n   193\t    int mode;               // Read/write mode\r\n   194\t    bool used;              // Whether this file descriptor is in use\r\n   195\t} FileDescriptor;\r\n   196\t\r\n   197\t// Global filesystem state\r\n   198\tstatic FileNode* root = NULL;\r\n   199\tstatic FileDescriptor fd_table[MAX_FILE_DESCRIPTORS];\r\n   200\t\r\n   201\t\r\n   202\tFileNode* create_node(const char* name, int type, FileNode* parent);\r\n   203\t\r\n   204\t// Helper function to initialize the filesystem\r\n   205\tvoid init_filesystem() {\r\n   206\t    // Create root directory if it doesn't exist\r\n   207\t    if (root == NULL) {\r\n   208\t        root = (FileNode*)malloc(sizeof(FileNode));\r\n   209\t        strcpy(root->name, \"/\");\r\n   210\t        root->type = FILE_TYPE_DIRECTORY;\r\n   211\t        root->created = root->modified = root->accessed = time(NULL);\r\n   212\t        root->data = NULL;\r\n   213\t        root->size = 0;\r\n   214\t        root->capacity = 0;\r\n   215\t        root->entries = (DirEntry*)malloc(10 * sizeof(DirEntry));\r\n   2"]
[493.216557, "o", "16\t        root->num_entries = 0;\r\n   217\t        root->max_entries = 10;\r\n   218\t        root->parent = root; // Root is its own parent\r\n   219\t        \r\n   220\t        // Initialize file descriptor table\r\n   221\t        for (int i = 0; i < MAX_FILE_DESCRIPTORS; i++) {\r\n   222\t            if (i < 5) {\r\n   223\t                fd_table[i].used = 1;  // Reserve file descriptors 0-4\r\n   224\t                fd_table[i].node = NULL;\r\n   225\t            } else {\r\n   226\t                fd_table[i].used = 0;\r\n   227\t            }\r\n   228\t        }\r\n   229\t        \r\n   230\t        // Load doom.wad from the real filesystem\r\n   231\t        const char* wad_path = \"doom.wad\";\r\n   232\t        \r\n   233\t        // Open the WAD file from the real filesystem\r\n   234\t        int real_fd = real_syscall6(SYS_open, (long)wad_path, O_RDONLY, 0, 0, 0, 0);\r\n   235\t        if (real_fd >= 0) {\r\n   236\t            // Get the file size\r\n   237\t            off_t file_size = real_syscall6(SYS_lseek, real_fd, 0, SEEK_END, 0, 0, 0);\r\n   238"]
[493.216752, "o", "\t            real_syscall6(SYS_lseek, real_fd, 0, SEEK_SET, 0, 0, 0); // Reset to beginning\r\n   239\t            \r\n   240\t            if (file_size > 0 && file_size <= MAX_FILE_SIZE) {\r\n   241\t                // Allocate memory for the file data\r\n   242\t                unsigned char* wad_data = (unsigned char*)malloc(file_size);\r\n   243\t                if (wad_data != NULL) {\r\n   244\t                    // Read the file data\r\n   245\t                    ssize_t bytes_read = real_syscall6(SYS_read, real_fd, (long)wad_data, file_size, 0, 0, 0);\r\n   246\t                    \r\n   247\t                    if (bytes_read == file_size) {\r\n   248\t                        // Create a new file node for doom.wad\r\n   249\t                        FileNode* wad_node = create_node(\"doom.wad\", FILE_TYPE_REGULAR, root);\r\n   250\t                        wad_node->data = wad_data;\r\n   251\t                        wad_node->size = file_size;\r\n   252\t                        wad_node->capacity = file_size;\r\n   253\t                        "]
[493.217081, "o", "\r\n   254\t                        // Add the file to the root directory\r\n   255\t                        add_to_directory(root, \"doom.wad\", wad_node);\r\n   256\t                        \r\n   257\t                        printf(\"Loaded doom.wad (%d bytes) into in-memory filesystem\\n\", file_size);\r\n   258\t                    } else {\r\n   259\t                        free(wad_data);\r\n   260\t                        printf(\"Failed to read doom.wad: read %d of %d bytes\\n\", bytes_read, file_size);\r\n"]
