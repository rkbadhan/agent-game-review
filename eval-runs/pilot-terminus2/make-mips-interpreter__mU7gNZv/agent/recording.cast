[493.215855, "o", "   148\t#define ENOTDIR 20     // Not a directory\r\n   149\t#define EMFILE 24      // Too many open files\r\n   150\t#define EINVAL 22      // Invalid argument\r\n   151\t#define EBADF 9        // Bad file descriptor\r\n   152\t#define ENOTEMPTY 39   // Directory not empty\r\n   153\t#define ENOMEM 12      // Out of memory\r\n   154\t#define EBUSY 16       // Device or resource busy\r\n   155\t\r\n   156\t// Forward declarations\r\n   157\tstruct FileNode;\r\n   158\ttypedef unsigned int mode_t;\r\n   159\ttypedef long off_t;\r\n   160\ttypedef long ssize_t;\r\n   161\t\r\n   162\t// Directory entry\r\n   163\ttypedef struct {\r\n   164\t    char name[MAX_PATH_LENGTH];\r\n   165\t    struct FileNode* node;\r\n   166\t} DirEntry;\r\n   167\t\r\n   168\t// File node structure\r\n   169\ttypedef struct FileNode {\r\n   170\t    char name[MAX_PATH_LENGTH];\r\n   171\t    int type;               // Regular file or directory\r\n   172\t    time_t created;         // Creation time\r\n   173\t    time_t modified;        // Last modification time\r\n   174\t    time_t accessed;        // Last a"]
