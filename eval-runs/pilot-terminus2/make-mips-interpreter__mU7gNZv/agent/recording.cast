[335.698136, "o", "     1\t/**\r\n     2\t * my_stdlib.c - Minimal standard library implementation\r\n     3\t * Contains stubs for all functions declared in my_stdlib.h\r\n     4\t */\r\n     5\t\r\n     6\t#include \"my_stdlib.h\"\r\n     7\t\r\n     8\t// System call numbers\r\n     9\t#define SYS_read    0\r\n    10\t#define SYS_write   1\r\n    11\t#define SYS_open    2\r\n    12\t#define SYS_close   3\r\n    13\t#define SYS_lseek   8\r\n    14\t#define SYS_fsync   74\r\n    15\t#define SYS_rename  82\r\n    16\t#define SYS_mkdir   83\r\n    17\t#define SYS_unlink  87\r\n    18\t\r\n    19\t#if defined(ARCH_X86)\r\n    20\t\r\n    21\t// Real syscall function for Linux x86_64\r\n    22\tstatic long real_syscall6(long syscall_num, long arg1, long arg2, long arg3,\r\n    23\t                     long arg4, long arg5, long arg6) {\r\n    24\t    long result;\r\n    25\t    \r\n    26\t    /*\r\n    27\t     * Use a simplified approach that directly specifies which\r\n    28\t     * registers to use for each argument\r\n    29\t     */\r\n    30\t    __asm__ volatile(\r\n"]
[335.698431, "o", "    31\t        /* Input arguments are already in the right locations */\r\n    32\t        \"syscall\"\r\n    33\t        : \"=a\" (result)\r\n    34\t        : \"a\" (syscall_num),\r\n    35\t          \"D\" (arg1),\r\n    36\t          \"S\" (arg2),\r\n    37\t          \"d\" (arg3),\r\n    38\t          \"r\" (arg4)   /* r10 */,\r\n    39\t          \"r\" (arg5)   /* r8 */,\r\n    40\t          \"r\" (arg6)   /* r9 */\r\n    41\t        : \"rcx\", \"r11\", \"memory\"\r\n    42\t    );\r\n    43\t    \r\n    44\t    /* Check for error and set errno */\r\n    45\t    if (result < 0 && result > -4096) {\r\n    46\t        errno = -result;\r\n    47\t        return -1;\r\n    48\t    }\r\n    49\t    \r\n    50\t    return result;\r\n    51\t\r\n    52\t}\r\n    53\t\r\n    54\t\r\n    55\t#else\r\n    56\t// Real syscall function for MIPS\r\n    57\tstatic long real_syscall6(long syscall_num, long arg1, long arg2, long arg3,\r\n    58\t                     long arg4, long arg5, long arg6) {\r\n    59\t    long result;\r\n    60\t    \r\n    61\t    /*\r\n    62\t     * Hacky MIPS syscall approach:\r\n"]
[335.698576, "o", "    63\t     * - Syscall number goes in $v0 (register 2)\r\n    64\t     * - First four arguments go in $a0-$a3 (registers 4-7)\r\n    65\t     * - Additional arguments go in $t0-$t1 (registers 8-9)\r\n    66\t     * - Result comes back in $v0 (register 2)\r\n    67\t     */\r\n    68\t    __asm__ volatile(\r\n    69\t        /* Load syscall number into $v0 */\r\n    70\t        \"move $v0, %1\\n\\t\"\r\n    71\t        \r\n    72\t        /* Load first four arguments into $a0-$a3 */\r\n    73\t        \"move $a0, %2\\n\\t\"\r\n    74\t        \"move $a1, %3\\n\\t\"\r\n    75\t        \"move $a2, %4\\n\\t\"\r\n    76\t        \"move $a3, %5\\n\\t\"\r\n    77\t        \r\n    78\t        /* Load additional arguments into $t0-$t1 */\r\n    79\t        \"move $t0, %6\\n\\t\"  /* 5th arg in $t0 */\r\n    80\t        \"move $t1, %7\\n\\t\"  /* 6th arg in $t1 */\r\n    81\t        \r\n    82\t        /* Make the syscall */\r\n    83\t        \"syscall\\n\\t\"\r\n    84\t        \r\n    85\t        /* Get the return value */\r\n    86\t        \"move %0, $v0\"\r\n    87\t        \r\n    88\t        /* Output parameter */\r\n "]
[335.698714, "o", "   89\t        : \"=r\" (result)\r\n    90\t        \r\n    91\t        /* Input parameters */\r\n    92\t        : \"r\" (syscall_num),\r\n    93\t          \"r\" (arg1),\r\n    94\t          \"r\" (arg2),\r\n    95\t          \"r\" (arg3),\r\n    96\t          \"r\" (arg4),\r\n    97\t          \"r\" (arg5),\r\n    98\t          \"r\" (arg6)\r\n    99\t        \r\n   100\t        /* Clobbered registers */\r\n   101\t        : \"v0\", \"a0\", \"a1\", \"a2\", \"a3\", \"t0\", \"t1\", \"memory\"\r\n   102\t    );\r\n   103\t    \r\n   104\t    /* \r\n   105\t     * MIPS typically uses negative return values for errors\r\n   106\t     * and sets errno accordingly\r\n   107\t     */\r\n   108\t    if (result < 0) {\r\n   109\t        errno = -result;\r\n   110\t        return -1;\r\n   111\t    }\r\n   112\t    \r\n   113\t    return result;\r\n   114\t}\r\n   115\t#endif\r\n   116\t\r\n   117\t#if 0\r\n   118\t// Constants for file operations\r\n   119\t#define MAX_PATH_LENGTH 256\r\n   120\t#define MAX_FILES 1024\r\n   121\t#define MAX_FILE_DESCRIPTORS 1024\r\n   122\t#define MAX_FILE_SIZE (64 * 1024 * 1024)  // 1MB max file size for simpli"]
