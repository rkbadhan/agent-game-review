   930	void* calloc(size_t nmemb, size_t size) {
   931	    size_t total_size = nmemb * size;
   932	    
   933	    // Check for overflow
   934	    if (size != 0 && total_size / size != nmemb) {
   935	      printf("NULL\n");
   936	        return NULL;
   937	    }
   938	    
   939	    void* ptr = malloc(total_size);
   940	    if (ptr) {
   941	        // Zero out the allocated memory
   942	        memset(ptr, 0, total_size);
   943	    }
   944	    return ptr;
   945	}
   946	
   947	// Main free with fast path for fixed-size pools
   948	// Define our static memory pool
   949	#define HEAP_SIZE (1024 * 1024 * 1024)  // 1 GB static heap
   950	static unsigned char heap[HEAP_SIZE] __attribute__((aligned(64)));  // Cache line aligned
   951	static size_t heap_pos = 0;  // Current position in the heap
   952	
   953	// Size classes for segregated free lists
   954	#define NUM_SIZE_CLASSES 32
   955	static void* free_lists[NUM_SIZE_CLASSES] = {NULL};
   956	
   957	// Alignment
   958	#define ALIGN_SIZE 8
   959	#define ALIGN_MASK (ALIGN_SIZE - 1)
   960	#define ALIGN_UP(size) (((size) + ALIGN_MASK) & ~ALIGN_MASK)
   961	
   962	// Block header
   963	typedef struct block_header {
   964	    size_t size;  // Size of the block (including header)
   965	} block_header_t;
   966	
   967	#define HEADER_SIZE ALIGN_UP(sizeof(block_header_t))
   968	#define MIN_BLOCK_SIZE ALIGN_UP(HEADER_SIZE + sizeof(void*))  // Minimum size to store a free list pointer
   969	
   970	// Get size class index for a given size
   971	static int size_class_index(size_t size) {
   972	    // For small sizes, use direct mapping to optimize common cases
   973	  /*
   974	    if (size <= 16) return 0;
   975	    if (size <= 32) return 1;
   976	    if (size <= 64) return 2;
   977	    if (size <= 128) return 3;
   978	    if (size <= 256) return 4;
   979	    if (size <= 512) return 5;
   980	    if (size <= 1024) return 6;
   981	  */
   982	    
   983	    // For larger sizes, use bit operations to find log2
   984	    int index = 0;  // Start after direct mapping
   985	    size >>= 4;    // Divide by 1024
   986	    
   987	    while (size) {
   988	        size >>= 1;
   989	        index++;
   990	    }
   991	    
   992	    return (index < NUM_SIZE_CLASSES) ? index : NUM_SIZE_CLASSES - 1;
   993	}
   994	
   995	// Basic malloc implementation using segregated free lists
   996	void* basic_malloc(size_t size) {
   997	    if (size == 0) return NULL;
   998	    
   999	    // Calculate total size needed including header
  1000	    size_t total_size = ALIGN_UP(HEADER_SIZE + size);
  1001	    
  1002	    // Ensure minimum block size
  1003	    if (total_size < MIN_BLOCK_SIZE)
  1004	        total_size = MIN_BLOCK_SIZE;
  1005	    
  1006	    // Get the appropriate size class
  1007	    int class_idx = size_class_index(total_size);
  1008	
  1009	    //printf("malloc %d\n", size);
  1010	    // Try to find a free block in this or larger size classes
  1011	    for (int i = class_idx; i < NUM_SIZE_CLASSES; i++) {
  1012	        if (free_lists[i]) {
  1013	            // Found a free block, remove it from the list
  1014	            void* block_ptr = free_lists[i];
  1015	            block_header_t* block = (block_header_t*)((char*)block_ptr - HEADER_SIZE);
  1016	            
  1017	            // Update free list to remove this block
  1018	            free_lists[i] = *((void**)block_ptr);
  1019	            
  1020	            // Split if the block is significantly larger (only for larger blocks to avoid overhead)
  1021	            if (i > class_idx + 1 && block->size >= total_size + MIN_BLOCK_SIZE + HEADER_SIZE) {
  1022	                // Calculate sizes
  1023	                size_t remaining_size = block->size - total_size;
  1024	                
  1025	                // Update current block size
  1026	                block->size = total_size;
  1027	                
  1028	                // Create new block from remainder
  1029	                block_header_t* new_block = (block_header_t*)((char*)block + total_size);
  1030	                new_block->size = remaining_size;
  1031	                
  1032	                // Add to appropriate free list
  1033	                int new_class = size_class_index(remaining_size);
  1034	                void* new_data = (char*)new_block + HEADER_SIZE;
  1035	                *((void**)new_data) = free_lists[new_class];
  1036	                free_lists[new_class] = new_data;
  1037	            }
  1038	            
  1039	            // Return the data portion of the block
  1040	            return block_ptr;
  1041	        }
  1042	    }
  1043	    
  1044	    // No free block found, allocate from the heap
  1045	    if (heap_pos + total_size > HEAP_SIZE)
  1046	        return NULL;  // Out of memory
  1047	    
  1048	    // Create a new block at the current heap position
  1049	    block_header_t* new_block = (block_header_t*)(heap + heap_pos);
  1050	    new_block->size = total_size;
  1051	    heap_pos += total_size;
  1052	    
  1053	    // Return the data portion of the block
  1054	    return (char*)new_block + HEADER_SIZE;
  1055	}
  1056	
  1057	// Simple and fast free implementation
  1058	void basic_free(void* ptr) {
  1059	    if (!ptr) return;
  1060	    
  1061	    // Get the block header
  1062	    block_header_t* block = (block_header_t*)((char*)ptr - HEADER_SIZE);
  1063	    
  1064	    // Validate the pointer
  1065	    if ((void*)block < (void*)heap || (void*)block >= (void*)(heap + heap_pos))
  1066	        return;  // Invalid pointer
  1067	    
  1068	    // Add to appropriate free list based on size
  1069	    int class_idx = size_class_index(block->size);
  1070	    *((void**)ptr) = free_lists[class_idx];
  1071	    free_lists[class_idx] = ptr;
  1072	}
  1073	
  1074	// Optional: Faster implementation for small, fixed-size allocations
  1075	#define NUM_POOLS 4                        // Number of pools for common sizes
  1076	#define POOL_SIZES {16, 32, 64, 128}      // Common allocation sizes
  1077	#define POOL_CHUNK_COUNT 1024             // Chunks per pool
  1078	
  1079	static struct {
  1080	    void* free_chunks;                     // Free chunk list
  1081	    unsigned char* memory;                 // Pool memory
  1082	    size_t chunk_size;                     // Size of each chunk
  1083	    size_t used_count;                     // Number of chunks used
  1084	} fixed_pools[NUM_POOLS];
  1085	
  1086	// Initialize fixed-size pools for common allocations
  1087	static void init_fixed_pools() {
  1088	    static int initialized = 0;
  1089	    if (initialized) return;
  1090	    
  1091	    const size_t sizes[NUM_POOLS] = POOL_SIZES;
  1092	    
  1093	    for (int i = 0; i < NUM_POOLS; i++) {
  1094	        size_t chunk_size = ALIGN_UP(sizes[i]);
  1095	        size_t pool_size = POOL_CHUNK_COUNT * chunk_size;
  1096	        
  1097	        // Allocate pool from the heap
  1098	        fixed_pools[i].memory = heap + heap_pos;
  1099	        fixed_pools[i].chunk_size = chunk_size;
  1100	        fixed_pools[i].used_count = 0;
  1101	        fixed_pools[i].free_chunks = NULL;
  1102	        
  1103	        // Initialize all chunks as free
  1104	        for (size_t j = 0; j < POOL_CHUNK_COUNT; j++) {
  1105	            void* chunk = fixed_pools[i].memory + (j * chunk_size);
  1106	            *((void**)chunk) = fixed_pools[i].free_chunks;
  1107	            fixed_pools[i].free_chunks = chunk;
  1108	        }
  1109	        
  1110	        heap_pos += pool_size;
  1111	    }
  1112	    
  1113	    initialized = 1;
  1114	}
  1115	
  1116	// Fast fixed-size allocation
  1117	static void* fixed_malloc(size_t size) {
  1118	    init_fixed_pools();
  1119	    
  1120	    const size_t sizes[NUM_POOLS] = POOL_SIZES;
  1121	    
  1122	    // Find appropriate pool
  1123	    for (int i = 0; i < NUM_POOLS; i++) {
  1124	        if (sizes[i] >= size && fixed_pools[i].free_chunks) {
  1125	            // Get a chunk from the free list
  1126	            void* chunk = fixed_pools[i].free_chunks;
  1127	            fixed_pools[i].free_chunks = *((void**)chunk);
  1128	            fixed_pools[i].used_count++;
  1129	            return chunk;
  1130	        }
  1131	    }
  1132	    
  1133	    return NULL;  // No suitable pool or no free chunks
  1134	}
  1135	
  1136	// Fast fixed-size free
  1137	static size_t get_block_size(void* ptr) {
  1138	    block_header_t* block = (block_header_t*)((char*)ptr - HEADER_SIZE);
  1139	    return block->size;
  1140	}
  1141	    static int fixed_free(void* ptr) {
  1142	    for (int i = 0; i < NUM_POOLS; i++) {
  1143	        unsigned char* pool_start = fixed_pools[i].memory;
  1144	        unsigned char* pool_end = pool_start + (POOL_CHUNK_COUNT * fixed_pools[i].chunk_size);
  1145	        
  1146	        if ((unsigned char*)ptr >= pool_start && (unsigned char*)ptr < pool_end) {
  1147	            // Check alignment
  1148	            size_t offset = (unsigned char*)ptr - pool_start;
  1149	            if (offset % fixed_pools[i].chunk_size != 0)
  1150	                return 0;  // Not properly aligned
  1151	                
  1152	            // Add back to free list
  1153	            *((void**)ptr) = fixed_pools[i].free_chunks;
  1154	            fixed_pools[i].free_chunks = ptr;
  1155	            fixed_pools[i].used_count--;
  1156	            return 1;  // Successfully freed
  1157	        }
  1158	    }
  1159	    
  1160	    return 0;  // Not in our pools
  1161	}
  1162	
  1163	// Main malloc with fast path for common sizes
  1164	void* malloc(size_t size) {
  1165	    if (size == 0) return NULL;
  1166	    
  1167	    // Try fixed-size allocation for small sizes
  1168	    if (size <= 128) {
  1169	        void* ptr = fixed_malloc(size);
  1170	        if (ptr) return ptr;
  1171	    }
  1172	    
  1173	    // Fall back to basic malloc
  1174	    return basic_malloc(size);
  1175	}
  1176	
  1177	// realloc implementation
  1178	// Minimal realloc implementation - just malloc/copy/free
  1179	void* realloc(void* ptr, size_t size) {
  1180	    // Handle special cases
  1181	    if (ptr == NULL) {
  1182	        return malloc(size);  // If ptr is NULL, behave like malloc
  1183	    }
  1184	    
  1185	    if (size == 0) {
  1186	        free(ptr);  // If size is 0, behave like free
  1187	        return NULL;
  1188	    }
  1189	    
