    20	static int FrameBufferFd = -1;
    21	static int* FrameBuffer = 0;
    22	
    23	static int KeyboardFd = -1;
    24	
    25	#define KEYQUEUE_SIZE 16
    26	
    27	static unsigned short s_KeyQueue[KEYQUEUE_SIZE];
    28	static unsigned int s_KeyQueueWriteIndex = 0;
    29	static unsigned int s_KeyQueueReadIndex = 0;
    30	
    31	static unsigned int s_PositionX = 0;
    32	static unsigned int s_PositionY = 0;
    33	
    34	static unsigned int s_ScreenWidth = 0;
    35	static unsigned int s_ScreenHeight = 0;
    36	
    37	enum EnFrameBuferIoctl
    38	{
    39	    FB_GET_WIDTH,
    40	    FB_GET_HEIGHT,
    41	    FB_GET_BITSPERPIXEL
    42	};
    43	
    44	static unsigned char convertToDoomKey(unsigned char scancode)
    45	{
    46	    unsigned char key = 0;
    47	
    48	    switch (scancode)
    49	    {
    50	    case 0x9C:
    51	    case 0x1C:
    52	        key = KEY_ENTER;
    53	        break;
    54	    case 0x01:
    55	        key = KEY_ESCAPE;
    56	        break;
    57	    case 0xCB:
    58	    case 0x4B:
    59	        key = KEY_LEFTARROW;
    60	        break;
    61	    case 0xCD:
    62	    case 0x4D:
    63	        key = KEY_RIGHTARROW;
    64	        break;
    65	    case 0xC8:
    66	    case 0x48:
    67	        key = KEY_UPARROW;
    68	        break;
    69	    case 0xD0:
    70	    case 0x50:
    71	        key = KEY_DOWNARROW;
    72	        break;
    73	    case 0x1D:
    74	        key = KEY_FIRE;
    75	        break;
    76	    case 0x39:
    77	        key = KEY_USE;
    78	        break;
    79	    case 0x2A:
    80	    case 0x36:
    81	        key = KEY_RSHIFT;
    82	        break;
    83	    case 0x15:
    84	        key = 'y';
    85	        break;
    86	    default:
    87	        break;
    88	    }
    89	
    90	    return key;
    91	}
    92	
    93	static void addKeyToQueue(int pressed, unsigned char keyCode)
    94	{
    95		//printf("key hex %x decimal %d\n", keyCode, keyCode);
    96	
    97	        unsigned char key = convertToDoomKey(keyCode);
    98	
    99	        unsigned short keyData = (pressed << 8) | key;
   100	
   101	        s_KeyQueue[s_KeyQueueWriteIndex] = keyData;
   102	        s_KeyQueueWriteIndex++;
   103	        s_KeyQueueWriteIndex %= KEYQUEUE_SIZE;
   104	}
   105	
   106	
   107	struct termios orig_termios;
   108	
   109	void disableRawMode()
   110	{
   111	  //printf("returning original termios\n");
   112	  tcsetattr(STDIN_FILENO, TCSAFLUSH, &orig_termios);
   113	}
   114	
   115	void enableRawMode()
   116	{
   117	  tcgetattr(STDIN_FILENO, &orig_termios);
   118	  atexit(disableRawMode);
   119	  struct termios raw = orig_termios;
   120	  raw.c_lflag &= ~(ECHO);
   121	  raw.c_cc[VMIN] = 0;
   122	  tcsetattr(STDIN_FILENO, TCSAFLUSH, &raw);
   123	}
   124	
   125	void DG_Init()
   126	{
   127	    FrameBufferFd = open("/dev/fb0", 0);
   128	
   129	    if (FrameBufferFd >= 0)
   130	    {
   131	        printf("Getting screen width...");
   132	        s_ScreenWidth = ioctl(FrameBufferFd, FB_GET_WIDTH);
   133	        printf("%d\n", s_ScreenWidth);
   134	
   135	        printf("Getting screen height...");
   136	        s_ScreenHeight = ioctl(FrameBufferFd, FB_GET_HEIGHT);
   137	        printf("%d\n", s_ScreenHeight);
   138	
   139	        if (0 == s_ScreenWidth || 0 == s_ScreenHeight)
   140	        {
   141	            printf("Unable to obtain screen info!");
   142	            exit(1);
   143	        }
   144	
   145	        FrameBuffer = mmap(NULL, s_ScreenWidth * s_ScreenHeight * 4, PROT_READ | PROT_WRITE, 0, FrameBufferFd, 0);
   146	
   147	        if (FrameBuffer != (int*)-1)
   148	        {
   149	            printf("FrameBuffer mmap success\n");
   150	        }
   151	        else
   152	        {
   153	            printf("FrameBuffermmap failed\n");
   154	        }
   155	    }
   156	    else
   157	    {
   158	        printf("Opening FrameBuffer device failed!\n");
   159	    }
   160	
   161	    enableRawMode();
   162	
   163	    KeyboardFd = open("/dev/keyboard", 0);
   164	
   165	    if (KeyboardFd >= 0)
   166	    {
   167	        //enter non-blocking mode
   168	        ioctl(KeyboardFd, 1, (void*)1);
   169	    }
   170	
   171	    int argPosX = 0;
   172	    int argPosY = 0;
   173	
   174	    argPosX = M_CheckParmWithArgs("-posx", 1);
   175	    if (argPosX > 0)
   176	    {
   177	        sscanf(myargv[argPosX + 1], "%d", &s_PositionX);
   178	    }
   179	
   180	    argPosY = M_CheckParmWithArgs("-posy", 1);
   181	    if (argPosY > 0)
   182	    {
   183	        sscanf(myargv[argPosY + 1], "%d", &s_PositionY);
   184	    }
   185	}
   186	
   187	static void handleKeyInput()
   188	{
   189	    if (KeyboardFd < 0)
   190	    {
   191	        return;
   192	    }
   193	
   194	    unsigned char scancode = 0;
   195	
   196	    if (read(KeyboardFd, &scancode, 1) > 0)
   197	    {
   198	        unsigned char keyRelease = (0x80 & scancode);
   199	
   200	        scancode = (0x7F & scancode);
   201	
   202	        //printf("scancode:%x pressed:%d\n", scancode, 0 == keyRelease);
   203	
   204	        if (0 == keyRelease)
   205	        {
   206	            addKeyToQueue(1, scancode);
   207	        }
   208	        else
   209	        {
   210	            addKeyToQueue(0, scancode);
   211	        }
   212	    }
   213	}
   214	
   215	void DG_DrawFrame()
   216	{
   217	    if (FrameBuffer)
   218	    {
   219	        for (int i = 0; i < DOOMGENERIC_RESY; ++i)
   220	        {
   221	            memcpy(FrameBuffer + s_PositionX + (i + s_PositionY) * s_ScreenWidth, DG_ScreenBuffer + i * DOOMGENERIC_RESX, DOOMGENERIC_RESX * 4);
   222	        }
   223	    }
   224	
   225	    handleKeyInput();
   226	}
   227	
   228	void DG_SleepMs(uint32_t ms)
   229	{
   230	    sleep_ms(ms);
   231	}
   232	
   233	uint32_t DG_GetTicksMs()
   234	{
   235	    return get_uptime_ms();
   236	}
   237	
   238	int DG_GetKey(int* pressed, unsigned char* doomKey)
   239	{
   240	    if (s_KeyQueueReadIndex == s_KeyQueueWriteIndex)
   241	    {
   242	        //key queue is empty
   243	
   244	        return 0;
   245	    }
   246	    else
   247	    {
   248	        unsigned short keyData = s_KeyQueue[s_KeyQueueReadIndex];
   249	        s_KeyQueueReadIndex++;
   250	        s_KeyQueueReadIndex %= KEYQUEUE_SIZE;
   251	
   252	        *pressed = keyData >> 8;
   253	        *doomKey = keyData & 0xFF;
   254	
   255	        return 1;
   256	    }
   257	}
   258	
   259	void DG_SetWindowTitle(const char * title)
   260	{
   261	}
   262	
   263	int main(int argc, char **argv)
   264	{
   265	    doomgeneric_Create(argc, argv);
   266	
   267	    for (int i = 0; ; i++)
   268	    {
   269	        doomgeneric_Tick();
   270	    }
   271	    
   272	
   273	    return 0;
   274	}

