    33	        : "=a" (result)
    34	        : "a" (syscall_num),
    35	          "D" (arg1),
    36	          "S" (arg2),
    37	          "d" (arg3),
    38	          "r" (arg4)   /* r10 */,
    39	          "r" (arg5)   /* r8 */,
    40	          "r" (arg6)   /* r9 */
    41	        : "rcx", "r11", "memory"
    42	    );
    43	    
    44	    /* Check for error and set errno */
    45	    if (result < 0 && result > -4096) {
    46	        errno = -result;
    47	        return -1;
    48	    }
    49	    
    50	    return result;
    51	
    52	}
