  1177	// realloc implementation
  1178	// Minimal realloc implementation - just malloc/copy/free
  1179	void* realloc(void* ptr, size_t size) {
  1180	    // Handle special cases
  1181	    if (ptr == NULL) {
  1182	        return malloc(size);  // If ptr is NULL, behave like malloc
  1183	    }
  1184	    
  1185	    if (size == 0) {
  1186	        free(ptr);  // If size is 0, behave like free
  1187	        return NULL;
  1188	    }
  1189	    
  1190	    // Get old size from block header
  1191	    block_header_t* block = (block_header_t*)((char*)ptr - HEADER_SIZE);
  1192	    size_t old_data_size = block->size - HEADER_SIZE;
  1193	    
  1194	    // Allocate new block
  1195	    void* new_ptr = malloc(size);
  1196	    if (new_ptr == NULL) {
  1197	        return NULL;  // Out of memory
  1198	    }
  1199	    
  1200	    // Copy data (use the smaller of old and new size)
  1201	    size_t copy_size = (old_data_size < size) ? old_data_size : size;
  1202	    memcpy(new_ptr, ptr, copy_size);
  1203	    
  1204	    // Free old block
  1205	    free(ptr);
  1206	    
  1207	    return new_ptr;
  1208	}
