  1141	    static int fixed_free(void* ptr) {
  1142	    for (int i = 0; i < NUM_POOLS; i++) {
  1143	        unsigned char* pool_start = fixed_pools[i].memory;
  1144	        unsigned char* pool_end = pool_start + (POOL_CHUNK_COUNT * fixed_pools[i].chunk_size);
  1145	        
  1146	        if ((unsigned char*)ptr >= pool_start && (unsigned char*)ptr < pool_end) {
  1147	            // Check alignment
  1148	            size_t offset = (unsigned char*)ptr - pool_start;
  1149	            if (offset % fixed_pools[i].chunk_size != 0)
  1150	                return 0;  // Not properly aligned
  1151	                
  1152	            // Add back to free list
  1153	            *((void**)ptr) = fixed_pools[i].free_chunks;
  1154	            fixed_pools[i].free_chunks = ptr;
  1155	            fixed_pools[i].used_count--;
  1156	            return 1;  // Successfully freed
  1157	        }
  1158	    }
  1159	    
  1160	    return 0;  // Not in our pools
  1161	}
