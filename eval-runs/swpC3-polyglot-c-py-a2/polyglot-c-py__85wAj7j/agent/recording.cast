[268.44663, "o", "    while (text[0] == '0' && text[1] != '\\0') {\r\n\u001b[?2004l\r\u001b[?2004h>         ++text;\r\n\u001b[?2004l\r"]
[268.446961, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[268.447231, "o", "\u001b[?2004h>     if (*text < '0' || *text > '9') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.44747, "o", "> "]
[268.447776, "o", "        return 0;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[268.448092, "o", "> "]
[268.448311, "o", "    while (*text >= '0' && *text <= '9') {\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.448606, "o", "> "]
[268.448869, "o", "        unsigned int digit = (unsigned int)(*text - '0');\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.449204, "o", "        if (value > (SIZE_MAX - digit) / 10) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.449449, "o", "            return 0;\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.449689, "o", ">         }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.449991, "o", "        value = value * 10 + digit;\r\n\u001b[?2004l\r\u001b[?2004h"]
[268.450205, "o", ">         ++text;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.450409, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.450742, "o", "    if (*text != '\\0') {\r\n\u001b[?2004l\r\u001b[?2004h>         return 0;\r\n\u001b[?2004l\r"]
[268.450988, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[268.45125, "o", "\u001b[?2004h> "]
[268.451492, "o", "    *result = value;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[268.451759, "o", "    return 1;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r"]
