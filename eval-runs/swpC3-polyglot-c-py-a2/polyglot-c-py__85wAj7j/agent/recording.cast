[268.363195, "i", "mkdir -p /app/polyglot && cat > /app/polyglot/main.py.c <<'EOF'\n#if 0\nimport sys\n\n\ndef fibonacci(n):\n    a, b = 0, 1\n    for _ in range(n):\n        a, b = b, a + b\n    return a\n\n\ndef run():\n    if len(sys.argv) != 2:\n        print(\"Usage: \" + sys.argv[0] + \" N\", file=sys.stderr)\n        return 1\n    try:\n        n = int(sys.argv[1], 10)\n    except ValueError:\n        print(\"N must be a nonnegative decimal integer\", file=sys.stderr)\n        return 1\n    if n < 0:\n        print(\"N must be a nonnegative decimal integer\", file=sys.stderr)\n        return 1\n    print(fibonacci(n))\n    return 0\n\n\nraise SystemExit(run())\nr\"\"\"\n#endif\n#include <inttypes.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n\n#define BIG_BASE UINT32_C(1000000000)\n#define BIG_WIDTH UINT32_C(9)\n\ntypedef struct {\n    uint32_t *limbs;\n    size_t length;\n    size_t capacity;\n} BigInteger;\n\nstatic void *xrealloc(void *pointer, size_t size)\n{\n    void *result = realloc(pointer, size);\n    if (result == NULL) {\n        fprintf(stderr, \"Out of memory\\n\");\n        exit(EXIT_FAILURE);\n    }\n    return result;\n}\n\nstatic void big_initialize(BigInteger *value, uint32_t limb)\n{\n    value->limbs = xrealloc(NULL, sizeof *value->limbs);\n    value->limbs[0] = limb;\n    value->length = 1;\n    value->capacity = 1;\n}\n\nstatic void big_reserve(BigInteger *value, size_t capacity)\n{\n    size_t new_capacity;\n\n    if (capacity <= value->capacity) {\n        return;\n    }\n    if (capacity > SIZE_MAX / sizeof *value->limbs) {\n        fprintf(stderr, \"Out of memory\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    new_capacity = value->capacity == 0 ? 1 : value->capacity;\n    while (new_capacity < capacity) {\n        if (new_capacity > SIZE_MAX / 2) {\n            new_capacity = capacity;\n            break;\n        }\n        new_capacity *= 2;\n    }\n    if (new_capacity > SIZE_MAX / sizeof *value->limbs) {\n        fprintf(stderr, \"Out of memory\\n\");\n        exit(EXIT_FAILURE);\n    }\n\n    value->limbs = xrealloc(value->limbs,\n                            new_capacity * sizeof *value->limbs);\n    value->capacity = new_capacity;\n}\n\nstatic void big_add(BigInteger *left, const BigInteger *right)\n{\n    size_t width = left->length > right->length ? left->length : right->length;\n    uint32_t carry = 0;\n    size_t i;\n\n    if (width == SIZE_MAX) {\n        fprintf(stderr, \"Out of memory\\n\");\n        exit(EXIT_FAILURE);\n    }\n    big_reserve(left, width + 1);\n\n    for (i = 0; i < width; ++i) {\n        uint64_t sum = carry;\n\n        if (i < left->length) {\n            sum += left->limbs[i];\n        }\n        if (i < right->length) {\n            sum += right->limbs[i];\n        }\n\n        if (sum >= BIG_BASE) {\n            left->limbs[i] = (uint32_t)(sum - BIG_BASE);\n            carry = 1;\n        } else {\n            left->limbs[i] = (uint32_t)sum;\n            carry = 0;\n        }\n    }\n\n    left->length = width;\n    if (carry != 0) {\n        left->limbs[width] = carry;\n        left->length = width + 1;\n    }\n}\n\nstatic void big_print(const BigInteger *value)\n{\n    size_t i;\n\n    printf(\"%\" PRIu32, value->limbs[value->length - 1]);\n    for (i = value->length - 1; i > 0; --i) {\n        printf(\"%09\" PRIu32, value->limbs[i - 1]);\n    }\n    putchar('\\n');\n}\n\nstatic int parse_count(const char *text, size_t *result)\n{\n    size_t value = 0;\n\n    if (*text == '+') {\n        ++text;\n    }\n    while (text[0] == '0' && text[1] != '\\0') {\n        ++text;\n    }\n    if (*text < '0' || *text > '9') {\n        return 0;\n    }\n\n    while (*text >= '0' && *text <= '9') {\n        unsigned int digit = (unsigned int)(*text - '0');\n\n        if (value > (SIZE_MAX - digit) / 10) {\n            return 0;\n        }\n        value = value * 10 + digit;\n        ++text;\n    }\n    if (*text != '\\0') {\n        return 0;\n    }\n\n    *result = value;\n    return 1;\n}\n\nint main(int argc, char **argv)\n{\n    BigInteger a;\n    BigInteger b;\n    size_t n;\n    size_t i;\n\n    if (argc != 2) {\n        fprintf(stderr, \"Usage: %s N\\n\", argv[0]);\n        return EXIT_FAILURE;\n    }\n    if (!parse_count(argv[1], &n)) {\n        fprintf(stderr, \""]
[268.363327, "i", "N must be a nonnegative decimal integer\\n\");\n        return EXIT_FAILURE;\n    }\n\n    big_initialize(&a, 0);\n    big_initialize(&b, 1);\n    for (i = 0; i < n; ++i) {\n        BigInteger temporary;\n\n        big_add(&a, &b);\n        temporary = a;\n        a = b;\n        b = temporary;\n    }\n\n    big_print(&a);\n    free(a.limbs);\n    free(b.limbs);\n    return EXIT_SUCCESS;\n}\n#if 0\n\"\"\"\n#endif\nEOF\npython3 -m py_compile /app/polyglot/main.py.c && gcc -Wall -Wextra -Wpedantic /app/polyglot/main.py.c -o /app/polyglot/cmain\n"]
