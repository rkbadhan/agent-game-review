[221.345896, "i", "bash <<'EOF'\nset -eu\nrm -f /etc/nginx/sites-enabled/default\nmkdir -p /var/www/html /var/log/nginx\nprintf '%s\\n' 'Welcome to the benchmark webserver' > /var/www/html/index.html\nprintf '%s\\n' 'Page not found - Please check your URL' > /var/www/html/404.html\nif ! grep -Eq '^[[:space:]]*log_format[[:space:]]+benchmark[[:space:]]' /etc/nginx/nginx.conf; then\n  sed -i \"/^[[:space:]]*http[[:space:]]*{/a\\\\    log_format benchmark '\\$time_local \\$request_method \\$status \"\\$http_user_agent\"';\" /etc/nginx/nginx.conf\nfi\nif ! grep -Eq '^[[:space:]]*limit_req_zone[[:space:]].*zone=benchmark_limit:' /etc/nginx/nginx.conf; then\n  sed -i \"/^[[:space:]]*http[[:space:]]*{/a\\\\    limit_req_zone \\$binary_remote_addr zone=benchmark_limit:10m rate=10r/s;\" /etc/nginx/nginx.conf\nfi\ncat > /etc/nginx/conf.d/benchmark-site.conf <<'NGINX'\nserver {\n    listen 8080;\n    server_name localhost;\n\n    root /var/www/html;\n    index index.html;\n\n    access_log /var/log/nginx/benchmark-access.log benchmark;\n    error_log /var/log/nginx/benchmark-"]
[221.346278, "i", "error.log;\n\n    limit_req zone=benchmark_limit burst=10;\n\n    location / {\n        try_files $uri $uri/ =404;\n    }\n\n    error_page 404 /404.html;\n\n    location = /404.html {\n        root /var/www/html;\n    }\n}\nNGINX\nnginx -t\nif [ -s /run/nginx.pid ] && kill -0 \"$(cat /run/nginx.pid)\" 2>/dev/null; then\n  nginx -s reload\nelse\n  nginx\nfi\nindex_body=\"$(curl -fsS http://127.0.0.1:8080/)\"\nnot_found_body=\"$(curl -sS http://127.0.0.1:8080/does-not-exist)\"\n[ \"$index_body\" = 'Welcome to the benchmark webserver' ]\n[ \"$not_found_body\" = 'Page not found - Please check your URL' ]\nprintf 'Index response: %s\\n' \"$index_body\"\nprintf '404 response: %s\\n' \"$not_found_body\"\nprintf 'Access log location: %s\\n' /var/log/nginx/benchmark-access.log\nls -l /var/log/nginx/benchmark-access.log\nEOF\n"]
