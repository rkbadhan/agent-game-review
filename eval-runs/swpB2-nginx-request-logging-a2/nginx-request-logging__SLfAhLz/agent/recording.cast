[221.363994, "o", "> nginx -t\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.364574, "o", "if [ -s /run/nginx.pid ] && kill -0 \"$(cat /run/nginx.pid)\" 2>/dev/null; then\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.364758, "o", "> "]
[221.364902, "o", "  nginx -s reload\r\n\u001b[?2004l\r"]
[221.365024, "o", "\u001b[?2004h> else\r\n\u001b[?2004l\r"]
[221.365139, "o", "\u001b[?2004h> "]
[221.365311, "o", "  nginx\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.365543, "o", "> fi\r\n"]
[221.365604, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[221.36616, "o", "index_body=\"$(curl -fsS http://127.0.0.1:8080/)\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[221.366521, "o", "not_found_body=\"$(curl -sS http://127.0.0.1:8080/does-not-exist)\"\r\n\u001b[?2004l\r"]
[221.366644, "o", "\u001b[?2004h> "]
[221.367067, "o", "[ \"$index_body\" = 'Welcome to the benchmark webserver' ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[221.367243, "o", "> "]
[221.367568, "o", "[ \"$not_found_body\" = 'Page not found - Please check your URL' ]\r\n\u001b[?2004l\r"]
[221.367708, "o", "\u001b[?2004h> "]
[221.367977, "o", "printf 'Index response: %s\\n' \"$index_body\"\r\n\u001b[?2004l\r"]
[221.368101, "o", "\u001b[?2004h> "]
[221.368351, "o", "printf '404 response: %s\\n' \"$not_found_body\"\r\n\u001b[?2004l\r"]
[221.368431, "o", "\u001b[?2004h> "]
[221.368868, "o", "printf 'Access log location: %s\\n' /var/log/nginx/benchmark-access.log\r\n\u001b[?2004l\r"]
[221.36904, "o", "\u001b[?2004h> "]
[221.369271, "o", "ls -l /var/log/nginx/benchmark-access.log\r\n\u001b[?2004l\r"]
[221.3694, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[221.398762, "o", "nginx: the configuration file /etc/nginx/nginx.conf syntax is ok\r\n"]
[221.402489, "o", "nginx: configuration file /etc/nginx/nginx.conf test is successful\r\n"]
[221.526891, "o", "Index response: Welcome to the benchmark webserver\r\n404 response: Page not found - Please check your URL\r\n"]
[221.527099, "o", "Access log location: /var/log/nginx/benchmark-access.log\r\n"]
[221.529389, "o", "-rw-r--r-- 1 root root 94 Aug 24 14:17 /var/log/nginx/benchmark-access.log\r\n"]
