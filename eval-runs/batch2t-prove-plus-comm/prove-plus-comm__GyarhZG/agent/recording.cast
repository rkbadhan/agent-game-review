[40.370571, "i", "cat plus_comm.v\n"]
[40.371068, "o", "cat plus_comm.v\r\n\u001b[?2004l\r"]
[40.373038, "o", "Require Import Arith.\r\n\r\nTheorem plus_comm : forall n m : nat,\r\n  n + m = m + n.\r\nProof.\r\n  intros n m.\r\n  induction n as [|n' IHn'].\r\n  - simpl.\r\n    (* 0 + m reduces to m, so use m = m + 0. *)\r\n    rewrite <- plus_n_O.\r\n    reflexivity.\r\n  - simpl.\r\n    (* Convert the goal using the induction hypothesis. *)\r\n    rewrite IHn'.\r\n    apply plus_n_Sm.\r\nQed. "]
[40.373894, "o", "\u001b[?2004hroot@4cf629367320:/workspace# "]
[40.62945, "i", "coqc plus_comm.v\n"]
[40.629959, "o", "coqc plus_comm.v\r\n\u001b[?2004l\r"]
