[163.361936, "o", "6:use Compress::Raw::Lzma qw (LZMA_STREAM_END LZMA_DICT_SIZE_MIN);\r\n23:# Compress::Raw::Lzma\r\n32:#    sudo cpan Compress::Raw::Lzma\r\n33:# or sudo apt-get install libcompress-raw-lzma-perl\r\n34:# or sudo perl -MCPAN -e 'install Compress::Raw::Lzma'\r\n840:sub lzma_properties_decode\r\n874:sub lzma_alone_header_field_encode\r\n1329:  # if it is lzma compressed, we need to decompress it first\r\n1343:    # lzma \"header\" stuff\r\n1347:    my ($property_lclppb, $dict_size, $lc, $pb, $lp) = lzma_properties_decode ($attributes);\r\n1365:      my $lz = new Compress::Raw::Lzma::AloneDecoder (AppendOutput => 1);\r\n1369:        $dict_size_encoded         = lzma_alone_header_field_encode ($dict_size,   4); # 4 bytes (the \"Dictionary Size\" field), little endian\r\n1370:        $uncompressed_size_encoded = lzma_alone_header_field_encode ($unpack_size, 8); # 8 bytes (the \"Uncompressed Size\" field), little endian\r\n1380:      my $lzma_alone_format_header = $property_lclppb . $dict_size_encoded . $uncompressed_size_encoded;\r\n1382:      my $lzma_header = $lzma_alone_format_header . $data;\r\n1384:      my $status = $lz->code ($lzma_header, $decompressed_header);\r\n1408:              print STDERR \"      (taken from the DOC/lzma-specification.txt file of the 7z-SDK: see for instance:\\n\";\r\n1409:              print STDERR \"       https://github.com/jljusten/LZMA-SDK/blob/master/DOC/lzma-specification.txt#L343-L347)\\n\";\r\n1531:    print STDERR \"WARNING: lzma2 compression found within '\" . $file_path . \"' is currently not supported, \";\r\n2120:    # codec_id: 030101   -> lzma  (we need to decompress - k_LZMA)\r\n2121:    # codec_id: 21       -> lzma2 (we need to decompress - k_LZMA2)\r\n"]
