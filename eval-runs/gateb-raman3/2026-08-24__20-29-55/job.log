        "explanation",
        "outcome"
      ],
      "title": "QualityCheckModel",
      "type": "object"
    }
  },
  "properties": {
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "checks": {
      "$ref": "#/$defs/AnalyzeResultChecks"
    }
  },
  "required": [
    "summary",
    "checks"
  ],
  "title": "AnalyzeResultResponse",
  "type": "object"
}
</output_schema>

