        "fail",
        "not_applicable"
      ],
      "title": "CheckOutcome",
      "type": "string"
    },
    "QualityCheckModel": {
      "properties": {
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CheckOutcome"
        }
      },
